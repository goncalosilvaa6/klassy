---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo = "Klassy Valongo | Unhas de Gel, Estética, Laser & Cabelo",
  descricao = "Centro de estética de referência em Valongo desde 2006. Especialistas em unhas de gel, verniz gel, depilação laser díodo, pestanas e bem-estar. Agende no WhatsApp.",
  imagem = "/og-image.jpg",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : "https://www.klassy.pt";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imagemCompleta = new URL(imagem, siteUrl).href;
---

<!doctype html>
<html lang="pt-PT" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta
      name="keywords"
      content="unhas valongo, unhas de gel valongo, verniz gel valongo, laser diodo valongo, depilacao laser valongo, lash lifting valongo, massagens renata franca valongo, cabeleireiro valongo, estetica valongo"
    />
    <meta name="author" content="Klassy - Nails, Beauty & Mind" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="geo.region" content="PT-13" />
    <meta name="geo.placename" content="Valongo" />
    <meta name="geo.position" content="41.190215;-8.500237" />
    <meta name="ICBM" content="41.190215, -8.500237" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={imagemCompleta} />
    <meta property="og:site_name" content="Klassy - Nails, Beauty & Mind" />
    <meta property="og:locale" content="pt_PT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemCompleta} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FAF8F5" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BeautySalon",
        "@id": "https://www.klassy.pt/#salon",
        "name": "Klassy - Nails, Beauty & Mind",
        "alternateName": [
          "Klassy Valongo",
          "Klassy Estética Valongo",
          "Klassy Nails",
          "Klassy Nails Beauty Mind",
          "Klassy Tu+ Bonita",
          "Tu+ Bonita"
        ],
        "url": "https://www.klassy.pt",
        "image": "https://www.klassy.pt/og-image.jpg",
        "telephone": "+351919786224",
        "email": "klassypt@gmail.com",
        "priceRange": "€€",
        "currenciesAccepted": "EUR",
        "paymentAccepted": "Cash",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. 5 de Outubro, 72 - Loja N, Edifício Vallis Longus",
          "addressLocality": "Valongo",
          "postalCode": "4440-503",
          "addressRegion": "Porto",
          "addressCountry": "PT"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.190215,
          "longitude": -8.500237
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday"
            ],
            "opens": "09:00",
            "closes": "19:30"
          }
        ],
        "sameAs": [
          "https://www.instagram.com/klassy.pt/",
          "https://www.facebook.com/klassy.pt",
          "https://www.tiktok.com/@klassypt"
        ],
        "areaServed": [
          { "@type": "City", "name": "Valongo" },
          { "@type": "City", "name": "Ermesinde" },
          { "@type": "City", "name": "Sobrado" },
          { "@type": "City", "name": "Gandra" },
          { "@type": "City", "name": "Porto" }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Catálogo de Tratamentos Klassy",
          "itemListElement": [
            {
              "@type": "OfferCatalog",
              "name": "Unhas & Manicure",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Unhas de Gel em Valongo"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Gelinho e Verniz Gel"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Unhas Imersão em Pó"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Pedicure de Cuidados"
                  }
                }
              ]
            },
            {
              "@type": "OfferCatalog",
              "name": "Olhar & Depilação à Linha",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Lash Lifting com Tintura"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Extensão de Pestanas"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Depilação à Linha Threading"
                  }
                }
              ]
            },
            {
              "@type": "OfferCatalog",
              "name": "Laser & Bem-Estar",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Depilação Laser Díodo"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Drenagem Método Renata França"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Limpeza de Pele Profunda"
                  }
                }
              ]
            }
          ]
        }
      }
    </script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
    </script>
  </head>

  <body
    id="topo"
    class="bg-white text-[var(--cor-texto)] antialiased min-h-screen flex flex-col selection:bg-[var(--cor-destaque)]/20 selection:text-[var(--cor-destaque)]"
  >
    <Header />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />
    <CookieBanner />

    <a
      href="https://wa.me/351919786224?text=Ol%C3%A1%2C+gostaria+de+agendar+uma+marca%C3%A7%C3%A3o+na+Klassy."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-[#25d366] hover:bg-[#1ebe57] text-white flex items-center justify-center shadow-lg shadow-emerald-500/25 hover:scale-110 active:scale-95 transition-all duration-300 group"
    >
      <span
        class="absolute -inset-1 rounded-full bg-emerald-400/35 animate-ping pointer-events-none group-hover:hidden"
      ></span>
      <svg
        viewBox="0 0 24 24"
        class="w-6 h-6 sm:w-7 sm:h-7 fill-current relative z-10 transition-transform duration-300 group-hover:scale-105"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
    </a>

    <a
      href="#topo"
      id="btn-voltar-topo"
      aria-label="Voltar ao topo da página"
      class="fixed bottom-22 right-6 sm:bottom-24 sm:right-7 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white flex items-center justify-center shadow-md shadow-[rgba(212,49,136,0.25)] transition-all duration-300 opacity-0 pointer-events-none translate-y-4 hover:-translate-y-1"
    >
      <svg
        viewBox="0 0 24 24"
        class="w-4 h-4 sm:w-5 sm:h-5 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </a>

    <script>
      let scrollListenerRegistado = false;

      const inicializarScrollTopo = () => {
        const btnTopo = document.getElementById("btn-voltar-topo");
        if (!btnTopo) return;

        const atualizarVisibilidade = () => {
          const visivel = window.scrollY > 350;
          btnTopo.classList.toggle("opacity-100", visivel);
          btnTopo.classList.toggle("pointer-events-auto", visivel);
          btnTopo.classList.toggle("translate-y-0", visivel);
          btnTopo.classList.toggle("opacity-0", !visivel);
          btnTopo.classList.toggle("pointer-events-none", !visivel);
          btnTopo.classList.toggle("translate-y-4", !visivel);
        };

        if (!scrollListenerRegistado) {
          window.addEventListener("scroll", atualizarVisibilidade, {
            passive: true,
          });
          scrollListenerRegistado = true;
        }

        atualizarVisibilidade();
      };

      const dispararEventoGA = (
        nomeEvento: string,
        params: Record<string, unknown>,
      ) => {
        const gtagFn = (
          window as unknown as { gtag?: (...args: unknown[]) => void }
        ).gtag;

        if (typeof gtagFn === "function") {
          gtagFn("event", nomeEvento, params);
        }
      };

      const registarEventosConversao = () => {
        const linksWhatsApp = document.querySelectorAll<HTMLAnchorElement>(
          'a[href*="wa.me"], a[href*="whatsapp.com"]',
        );
        linksWhatsApp.forEach((link) => {
          if (link.dataset.gaRegistado) return;
          link.dataset.gaRegistado = "true";

          link.addEventListener("click", () => {
            dispararEventoGA("click_whatsapp", {
              event_category: "Conversao",
              origem_pagina: window.location.pathname,
            });
          });
        });

        const linksTelefone =
          document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]');
        linksTelefone.forEach((link) => {
          if (link.dataset.gaRegistado) return;
          link.dataset.gaRegistado = "true";

          link.addEventListener("click", () => {
            dispararEventoGA("click_telefone", {
              event_category: "Conversao",
              origem_pagina: window.location.pathname,
            });
          });
        });

        const linksRedes =
          document.querySelectorAll<HTMLAnchorElement>("[data-rede-social]");
        linksRedes.forEach((link) => {
          if (link.dataset.gaRegistado) return;
          link.dataset.gaRegistado = "true";

          link.addEventListener("click", () => {
            dispararEventoGA("click_rede_social", {
              event_category: "Redes Sociais",
              rede: link.getAttribute("data-rede-social") || "Outra",
              origem_pagina: window.location.pathname,
            });
          });
        });
      };

      const inicializarTudo = () => {
        inicializarScrollTopo();
        registarEventosConversao();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", inicializarTudo);
      } else {
        inicializarTudo();
      }

      document.addEventListener("astro:page-load", inicializarTudo);
    </script>
  </body>
</html>
