---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo = "Klassy | Nails, Beauty & Mind em Valongo",
  descricao = "Centro de estética de referência em Valongo desde 2006. Unhas de gel, depilação laser, estética avançada e massagens.",
  imagem = "/og-image.jpg",
} = Astro.props;

const urlSite = "https://www.klassy.pt";
const canonicalUrl = Astro.url.href;
const imagemCompleta = new URL(imagem, urlSite).href;
---

<!doctype html>
<html lang="pt-PT" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO PRINCIPAL -->
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta
      name="keywords"
      content="unhas valongo, unhas de gel valongo, laser diodo 3 ondas, depilação laser valongo, massagens renata frança, estética avançada valongo, sobrancelhas valongo"
    />
    <meta name="author" content="Klassy - Nails, Beauty & Mind" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={imagemCompleta} />
    <meta property="og:site_name" content="Klassy" />
    <meta property="og:locale" content="pt_PT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemCompleta} />

    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BeautySalon",
        "name": "Klassy - Nails, Beauty & Mind",
        "image": "https://www.klassy.pt/og-image.jpg",
        "url": "https://www.klassy.pt",
        "telephone": "+351919786224",
        "email": "klassypt@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. 5 de Outubro, 72 - Loja N, Edifício Vallis Longus",
          "addressLocality": "Valongo",
          "postalCode": "4440-503",
          "addressRegion": "Porto",
          "addressCountry": "PT"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.190215,
          "longitude": -8.500237
        },
        "priceRange": "$$"
      }
    </script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
    </script>
  </head>

  <body
    id="topo"
    class="bg-white text-[var(--cor-texto)] antialiased min-h-screen flex flex-col selection:bg-[var(--cor-destaque)]/20 selection:text-[var(--cor-destaque)]"
  >
    <Header />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />
    <CookieBanner />

    <a
      href="https://wa.me/351919786224?text=Ol%C3%A1%2C+gostaria+de+agendar+uma+marca%C3%A7%C3%A3o(escreva+aqui)"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      class="fixed bottom-6 right-6 z-40 w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25d366] hover:bg-[#1ebe57] text-white flex items-center justify-center shadow-lg shadow-emerald-500/30 hover:scale-110 active:scale-95 transition-all duration-300 group"
    >
      <span
        class="absolute -inset-1 rounded-full bg-emerald-400/40 animate-ping pointer-events-none group-hover:hidden"
      ></span>
      <svg
        viewBox="0 0 24 24"
        class="w-7 h-7 sm:w-8 sm:h-8 fill-current relative z-10 transition-transform duration-300 group-hover:scale-105"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
    </a>

    <a
      href="#topo"
      id="btn-voltar-topo"
      aria-label="Voltar ao topo da página"
      class="fixed bottom-24 right-7 z-30 w-11 h-11 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white flex items-center justify-center shadow-md shadow-[rgba(212,49,136,0.3)] transition-all duration-300 opacity-0 pointer-events-none translate-y-4 hover:-translate-y-1"
    >
      <svg
        viewBox="0 0 24 24"
        class="w-5 h-5 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </a>

    <script>
      const gerirBotaoTopo = () => {
        const btnTopo = document.getElementById("btn-voltar-topo");
        if (btnTopo) {
          window.addEventListener("scroll", () => {
            if (window.scrollY > 350) {
              btnTopo.classList.remove(
                "opacity-0",
                "pointer-events-none",
                "translate-y-4",
              );
              btnTopo.classList.add(
                "opacity-100",
                "pointer-events-auto",
                "translate-y-0",
              );
            } else {
              btnTopo.classList.remove(
                "opacity-100",
                "pointer-events-auto",
                "translate-y-0",
              );
              btnTopo.classList.add(
                "opacity-0",
                "pointer-events-none",
                "translate-y-4",
              );
            }
          });
        }
      };

      document.addEventListener("DOMContentLoaded", gerirBotaoTopo);
      document.addEventListener("astro:page-load", gerirBotaoTopo);
    </script>
  </body>
</html>
