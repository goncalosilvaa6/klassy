---
// src/layouts/LayoutBase.astro
import "../styles/global.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import CookieBanner from "../components/cookiebanner.astro";

const { titulo } = Astro.props;
const urlSite = "https://www.klassy.pt";
---

<html lang="pt-PT">
  <head>
    <!-- Configurações Básicas e Técnicas -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- SEO Standard -->
    <title>{titulo}</title>
    <meta
      name="description"
      content="Centro de estética de referência em Valongo desde 2006. Nails, Beauty & Mind dedicada à mulher moderna e exigente."
    />
    <meta
      name="keywords"
      content="unhas valongo, unhas de gel valongo, laser diodo 3 ondas, depilação laser valongo, massagens renata frança, estética avançada valongo"
    />
    <meta name="author" content="Klassy.pt" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Portuguese" />
    <meta name="revisit-after" content="1 day" />

    <!-- Open Graph / Facebook / WhatsApp (Como o link aparece ao ser partilhado) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlSite} />
    <meta
      property="og:title"
      content="Klassy | Nails, Beauty & Mind em Valongo"
    />
    <meta
      property="og:description"
      content="Realçamos a sua essência com detalhe e dedicação. Estética Básica e Avançada."
    />
    <meta property="og:image" content={`${urlSite}/og-image.jpg`} />
    <!-- Criar uma imagem 1200x630px na pasta public -->
    <meta property="og:site_name" content="Klassy" />

    <!-- Twitter Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Klassy | Centro de Estética" />
    <meta
      name="twitter:description"
      content="Especialistas em beleza e bem-estar em Valongo."
    />

    <!-- Favicon (O ícone que aparece na aba do browser) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical URL (Evita conteúdo duplicado para o Google) -->
    <link rel="canonical" href={urlSite} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      // Nota: O carregamento real é controlado apenas pelo CookieBanner.astro
    </script>
  </head>
  <!-- 1. Adicionámos o ID topo para a âncora do botão funcionar -->
  <body id="topo">
    <Cabecalho />

    <main>
      <slot />
    </main>

    <Rodape />

    <a
      href="https://wa.me/351919786224"
      target="_blank"
      rel="noopener"
      class="botao-whatsapp"
      aria-label="Falar no WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
    </a>

    <CookieBanner />

    <a
      href="#topo"
      id="btn-voltar-topo"
      class="botao-subir oculto"
      aria-label="Voltar ao topo"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </a>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const btnTopo = document.getElementById("btn-voltar-topo");
        if (btnTopo) {
          window.addEventListener("scroll", () => {
            if (window.scrollY > 300) {
              btnTopo.classList.remove("oculto");
              btnTopo.classList.add("visivel");
            } else {
              btnTopo.classList.remove("visivel");
              btnTopo.classList.add("oculto");
            }
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  /* --- O NOVO BOTÃO DO WHATSAPP --- */
  .botao-whatsapp {
    position: fixed;
    bottom: 2.5rem;
    right: 2.5rem;
    width: 60px;
    height: 60px;
    background-color: #25d366; /* Verde oficial do WhatsApp */
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
    z-index: 10000; /* Acima do botão subir */
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
    animation: pulsoWA 2s infinite; /* Chama a atenção subtilmente */
  }

  .botao-whatsapp:hover {
    background-color: #1ebe57;
    transform: scale(1.1);
    animation: none; /* Para de pulsar quando a pessoa passa o rato */
  }

  @keyframes pulsoWA {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    }
    70% {
      box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  /* --- BOTÃO VOLTAR AO TOPO REAJUSTADO --- */
  .botao-subir {
    position: fixed;
    /* REAJUSTE: Empurrado para cima (9rem) para ficar acima do WhatsApp */
    bottom: 7.5rem;
    right: 2.8rem;
    width: 45px;
    height: 45px;
    background-color: var(--cor-destaque);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 5px 15px rgba(119, 156, 133, 0.4);
    z-index: 9999;
    transition:
      transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
      background-color 0.3s ease,
      opacity 0.4s ease,
      visibility 0.4s ease;
  }

  .botao-subir.oculto {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(20px);
  }

  .botao-subir.visivel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .botao-subir svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .botao-subir.visivel:hover {
    background-color: var(--cor-destaque-hover);
    transform: translateY(-5px);
  }

  .botao-subir.visivel:hover svg {
    transform: translateY(-3px);
  }

  /* --- RESPONSIVIDADE TELEMÓVEL --- */
  @media (max-width: 768px) {
    .botao-whatsapp {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 55px;
      height: 55px;
    }

    .botao-subir {
      /* No telemóvel, escondemos o Voltar ao Topo. É inútil e polui o ecrã. */
      display: none !important;
    }
  }
</style>
