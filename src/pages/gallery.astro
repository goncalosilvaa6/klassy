---
import LayoutBase from "../layouts/BaseLayout.astro";
import GalleryHero from "../components/sections/GalleryHero.astro";
import GalleryFilter from "../components/sections/GalleryFilter.astro";
import GalleryGrid from "../components/sections/GalleryGrid.astro";
import GalleryCTA from "../components/sections/GalleryCTA.astro";
---

<LayoutBase
  titulo="Galeria & Portefólio | Trabalhos de Estética em Valongo - Klassy"
  descricao="Explore os resultados reais dos nossos trabalhos em unhas de gel, nail art, lash lifting, massagens e o espaço Klassy no centro de Valongo."
>
  <main class="w-full flex flex-col">
    <GalleryHero />
    <GalleryFilter />
    <GalleryGrid />
    <GalleryCTA />
  </main>
</LayoutBase>
