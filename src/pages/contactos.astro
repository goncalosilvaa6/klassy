---
// src/pages/contactos.astro
import LayoutBase from "../layouts/LayoutBase.astro";
---

<LayoutBase titulo="Contactos e Horários | Klassy">
  <!-- 1. HEADER CRIATIVO (Mantido conforme pediste) -->
  <section class="header-criativo">
    <div class="decor-text">KLASSY</div>
    <div class="header-grid">
      <div class="titulo-wrapper">
        <nav class="bread">Início / Contactos</nav>
        <h1>Onde a sua <em>Beleza</em> ganha uma morada.</h1>
      </div>
      <div class="apoio-wrapper">
        <p>
          Seja para um momento de cuidado pessoal ou para uma visão de parceria
          estratégica, o nosso espaço está aberto para si.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. GRELHA DE INFORMAÇÃO PROFISSIONAL (Inspirada na referência) -->
  <section class="info-profissional-wrapper">
    <div class="info-container">
      <div class="topo-info-grid">
        <!-- COLUNA 1: Contactos -->
        <div class="coluna-dado">
          <div class="icone-titulo">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
            <h2>Contactos</h2>
          </div>

          <div class="bloco-texto">
            <h3>Telefone</h3>
            <p class="destaque-dado">+351 919 786 224</p>
            <span class="nota-pequena">*chamada para rede móvel nacional</span>
          </div>

          <div class="bloco-texto mt-extra">
            <h3>Email</h3>
            <a href="mailto:klassypt@gmail.com" class="destaque-link"
              >klassypt@gmail.com</a
            >
          </div>
        </div>

        <!-- COLUNA 2: Horários -->
        <div class="coluna-dado">
          <div class="icone-titulo">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
            <h2>Horários</h2>
          </div>

          <div class="bloco-texto">
            <h3>De terça a sexta-feira</h3>
            <p>09h - 19h30</p>
          </div>

          <div class="bloco-texto">
            <h3>Sábado</h3>
            <p>09h - 19h30</p>
          </div>

          <div class="bloco-texto">
            <h3>Domingo e segunda-feira</h3>
            <p>Encerrados</p>
          </div>
        </div>

        <!-- COLUNA 3: Ação e Redes Sociais -->
        <div class="coluna-dado">
          <div class="bloco-texto">
            <h3 class="titulo-simples">Precisa de ajuda?</h3>
            <a href="tel:+351919786224" class="botao-outline">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
              Ligue Agora
            </a>
          </div>

          <div class="bloco-texto mt-extra">
            <h3 class="titulo-simples">Siga-nos nas redes sociais</h3>
            <div class="redes-circulos">
              <a
                href="https://www.instagram.com/klassy.pt/"
                aria-label="Instagram">IG</a
              >
              <a href="#" aria-label="Facebook">FB</a>
              <a href="#" aria-label="TikTok">TK</a>
              <a href="#" aria-label="WhatsApp">WA</a>
            </div>
          </div>
        </div>
      </div>

      <div class="linha-separadora"></div>

      <!-- ZONA INFERIOR: Localização e Mapa -->
      <div class="fundo-info-grid">
        <div class="coluna-dado">
          <div class="icone-titulo">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            <h2>Localização</h2>
          </div>

          <div class="bloco-texto">
            <h3>Klassy Estética Avançada</h3>
            <p>
              Av. 5 Outubro, 72 - Loja N | Edifício Vallis Longus<br />4440-503
              Valongo, Porto
            </p>
          </div>
        </div>

        <div class="coluna-mapa">
          <div class="caixa-mapa">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3002.4475453363066!2d-8.500237123567883!3d41.19021540820164!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd2463fa38ca0c4d%3A0xe8f854a78a9a29fa!2sKlassy%20-%20Nails%2C%20Beauty%20%26%20Mind%20-%20Centro%20de%20Est%C3%A9tica%20%7C%20Tu%2B%20Bonita!5e0!3m2!1spt-PT!2spt!4v1780437611756!5m2!1spt-PT!2spt"
              width="100%"
              height="250"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</LayoutBase>

<style>
  /* TIPOGRAFIA E BASE */
  em {
    font-family: serif;
    font-style: italic;
    color: var(--cor-destaque);
  }

  /* ANIMAÇÕES DE ENTRADA LUXUOSAS */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* HEADER CRIATIVO */
  .header-criativo {
    padding: 8rem 10% 4rem;
    position: relative;
    background: #ffffff;
    overflow: hidden;
  }

  .decor-text {
    position: absolute;
    top: -20px;
    left: -20px;
    font-size: 15rem;
    font-weight: 900;
    color: #f9f9f9;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: fadeUp 1.2s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
  }

  .header-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: flex-end;
    gap: 4rem;
    animation: fadeUp 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
  }

  h1 {
    font-size: 3.5rem;
    line-height: 1.1;
    max-width: 600px;
    color: #222;
  }

  .bread {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #999;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .apoio-wrapper p {
    color: #666;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* --- GRELHA DE INFORMAÇÃO PROFISSIONAL --- */
  .info-profissional-wrapper {
    /* CORREÇÃO: Usar o fundo verde gelo suave que definimos no global.css */
    background-color: var(--cor-fundo-suave);
    padding: 6rem 10%;
  }

  .info-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .topo-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  /* Ícones e Títulos das Colunas */
  .icone-titulo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 2.5rem;
  }

  .icone-titulo svg {
    width: 32px;
    height: 32px;
    color: var(--cor-destaque); /* Ícones agora assumem o verde da marca */
    margin-bottom: 1rem;
    transition: transform 0.4s ease;
  }

  /* Interatividade: O ícone levanta ligeiramente quando passamos o rato na coluna */
  .coluna-dado:hover .icone-titulo svg {
    transform: translateY(-5px);
  }

  .icone-titulo h2 {
    font-size: 1.2rem;
    color: #333;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* Blocos de Texto Internos */
  .bloco-texto {
    margin-bottom: 2rem;
  }

  .bloco-texto h3 {
    font-size: 1rem;
    color: #333;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .titulo-simples {
    color: #666 !important;
  }

  .bloco-texto p {
    color: #666;
    font-size: 1rem;
    line-height: 1.5;
  }

  .destaque-dado {
    font-size: 1.1rem !important;
    font-weight: 600;
    color: #444 !important;
  }

  .destaque-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: #444;
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }

  /* Interatividade: Sublinhado que cresce no link de email */
  .destaque-link::after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--cor-destaque);
    transition: width 0.3s ease;
  }

  .destaque-link:hover {
    color: var(--cor-destaque);
  }

  .destaque-link:hover::after {
    width: 100%;
  }

  .nota-pequena {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin-top: 0.3rem;
  }

  .mt-extra {
    margin-top: 3rem;
  }

  /* Botão de Ação */
  .botao-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 2rem;
    border: 1px solid #ccc;
    border-radius: 30px;
    color: #444;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  /* Interatividade: Botão enche com a cor da marca e o ícone mexe */
  .botao-outline:hover {
    border-color: var(--cor-destaque);
    background-color: var(--cor-destaque);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(119, 156, 133, 0.2);
  }

  .botao-outline:hover svg {
    animation: shake 0.5s ease-in-out;
  }

  @keyframes shake {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-10deg);
    }
    75% {
      transform: rotate(10deg);
    }
  }

  /* Redes Sociais */
  .redes-circulos {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .redes-circulos a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border: 1px solid #ccc;
    border-radius: 50%;
    color: #444;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Efeito de mola */
  }

  /* Interatividade: Círculos saltam ligeiramente */
  .redes-circulos a:hover {
    border-color: var(--cor-destaque);
    color: #fff;
    background-color: var(--cor-destaque);
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 5px 15px rgba(119, 156, 133, 0.3);
  }

  /* Linha de Separação */
  .linha-separadora {
    height: 1px;
    background-color: #eaeaea;
    margin: 4rem 0;
  }

  /* Zona Inferior (Mapa) */
  .fundo-info-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  .caixa-mapa {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    padding: 5px;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .caixa-mapa:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
  }

  /* RESPONSIVIDADE */
  @media (max-width: 950px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .decor-text {
      font-size: 8rem;
    }
    .topo-info-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .fundo-info-grid {
      grid-template-columns: 1fr;
    }
    .linha-separadora {
      margin: 3rem 0;
    }
    .mt-extra {
      margin-top: 2rem;
    }
  }
</style>
