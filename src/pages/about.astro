---
import LayoutBase from "../layouts/BaseLayouts.astro";
import AboutHero from "../components/sections/AboutHero.astro";
import AboutFounder from "../components/sections/AboutFounder.astro";
import AboutValues from "../components/sections/AboutValues.astro";
import AboutExperience from "../components/sections/AboutExperience.astro";
---

<LayoutBase
  titulo="Sobre a Klassy Valongo | Tradição e Excelência em Beleza desde 2006"
  descricao="Conheça a história e a equipa da Klassy em Valongo. Mais de 19 anos dedicados ao rigor técnico, estética avançada e autoestima feminina num refúgio acolhedor."
>
  <main class="w-full flex flex-col">
    <AboutHero />
    <AboutFounder />
    <AboutValues />
    <AboutExperience />
  </main>
</LayoutBase>
