---
// src/pages/galeria.astro
import LayoutBase from "../layouts/LayoutBase.astro";
import { Image } from "astro:assets";

// Importa as tuas fotos reais aqui
import img1 from "../assets/foto.jpeg";
import img2 from "../assets/foto.jpeg";
import img3 from "../assets/foto.jpeg";
import img4 from "../assets/foto.jpeg";
import img5 from "../assets/foto.jpeg";
import img6 from "../assets/foto.jpeg";
---

<LayoutBase titulo="Galeria de Resultados | Klassy">
  <header class="cabecalho-galeria animar-entrada">
    <span class="etiqueta">Portefólio</span>
    <h1>A Excelência em Cada Detalhe</h1>
    <p>Resultados reais que transformam a confiança das nossas clientes.</p>
  </header>

  <section class="container-galeria">
    <div class="masonry-grid animar-entrada-atraso">
      <div class="item-galeria grande trigger-lightbox" data-src={img1.src}>
        <Image
          src={img1}
          alt="Trabalho de estética facial detalhado"
          class="foto"
        />
        <div class="legenda">
          <span class="categoria">Estética Facial</span>
          <span class="detalhe">Limpeza profunda e hidratação</span>
        </div>
      </div>

      <div class="item-galeria trigger-lightbox" data-src={img2.src}>
        <Image src={img2} alt="Manicure profissional" class="foto" />
        <div class="legenda">
          <span class="categoria">Nail Design</span>
          <span class="detalhe">Extensão em Gel e Molde F1</span>
        </div>
      </div>

      <div class="item-galeria trigger-lightbox" data-src={img3.src}>
        <Image src={img3} alt="Ambiente do salão" class="foto" />
        <div class="legenda">
          <span class="categoria">O Nosso Espaço</span>
          <span class="detalhe">Conforto e segurança máxima</span>
        </div>
      </div>

      <div class="item-galeria vertical trigger-lightbox" data-src={img4.src}>
        <Image src={img4} alt="Tratamento de corpo" class="foto" />
        <div class="legenda">
          <span class="categoria">Cuidados de Corpo</span>
          <span class="detalhe">Drenagem Linfática Manual</span>
        </div>
      </div>

      <div class="item-galeria trigger-lightbox" data-src={img5.src}>
        <Image src={img5} alt="Detalhe de verniz gel" class="foto" />
        <div class="legenda">
          <span class="categoria">Manicure Premium</span>
          <span class="detalhe">Verniz Gel de Alta Durabilidade</span>
        </div>
      </div>

      <div class="item-galeria horizontal trigger-lightbox" data-src={img6.src}>
        <Image src={img6} alt="Sessão de massagem" class="foto" />
        <div class="legenda">
          <span class="categoria">Bem-Estar</span>
          <span class="detalhe">Massagem Relaxante Terapêutica</span>
        </div>
      </div>
    </div>
  </section>

  <footer class="cta-galeria animar-entrada-atraso-2">
    <p>Gostou do que viu? Seja a nossa próxima história de sucesso.</p>
    <a href="/contactos" class="botao-principal">Marcar a minha avaliação</a>
  </footer>

  <!-- SISTEMA LIGHTBOX (Ecrã Inteiro) -->
  <div id="lightbox" class="lightbox-oculto">
    <button id="fechar-lightbox" aria-label="Fechar galeria">✕</button>
    <img id="imagem-lightbox" src="" alt="Imagem em detalhe" />
  </div>
</LayoutBase>

<style>
  /* ANIMAÇÕES GLOBAIS */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animar-entrada {
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
  }
  .animar-entrada-atraso {
    opacity: 0;
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) 0.3s forwards;
  }
  .animar-entrada-atraso-2 {
    opacity: 0;
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) 0.6s forwards;
  }

  /* CABEÇALHO */
  .cabecalho-galeria {
    text-align: center;
    padding: 8rem 2rem 5rem;
  }

  .etiqueta {
    color: var(--cor-destaque);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    font-size: 0.75rem;
  }

  h1 {
    font-family: serif;
    font-size: 3.5rem;
    margin: 1rem 0;
    color: var(--cor-texto);
  }

  .cabecalho-galeria p {
    color: var(--cor-texto-suave);
    font-size: 1.1rem;
  }

  /* GRELHA MASONRY */
  .container-galeria {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-auto-rows: 280px;
    grid-auto-flow: dense;
    gap: 1.5rem;
  }

  .item-galeria {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    cursor: zoom-in; /* Cursor altera para indicar clique */
    background-color: var(--cor-fundo-suave);
  }

  .grande {
    grid-column: span 2;
    grid-row: span 2;
  }
  .vertical {
    grid-row: span 2;
  }
  .horizontal {
    grid-column: span 2;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1),
      filter 0.8s ease;
    display: block;
  }

  /* EFEITO DE HOVER PREMIUM */
  .item-galeria:hover .foto {
    transform: scale(1.05);
    filter: brightness(0.7) blur(2px); /* Escurece e desfoca o fundo para destacar o texto */
  }

  .legenda {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem 2rem 2rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
    color: white;
    opacity: 0;
    transform: translateY(20px); /* Texto começa mais abaixo */
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .categoria {
    font-family: serif;
    font-size: 1.5rem;
    margin-bottom: 0.3rem;
  }

  .detalhe {
    font-size: 0.85rem;
    color: #e0e0e0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .item-galeria:hover .legenda {
    opacity: 1;
    transform: translateY(0); /* Texto desliza para o sítio */
  }

  .cta-galeria {
    text-align: center;
    background-color: var(--cor-fundo-suave);
    padding: 6rem 2rem;
  }

  .cta-galeria p {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
  }

  /* LIGHTBOX STYLES */
  #lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  #lightbox.ativo {
    opacity: 1;
    pointer-events: auto;
  }

  #imagem-lightbox {
    max-width: 90%;
    max-height: 90vh;
    border-radius: 4px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transform: scale(0.95);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  #lightbox.ativo #imagem-lightbox {
    transform: scale(1);
  }

  #fechar-lightbox {
    position: absolute;
    top: 2rem;
    right: 3rem;
    background: none;
    border: none;
    color: white;
    font-size: 2.5rem;
    cursor: pointer;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  #fechar-lightbox:hover {
    color: var(--cor-destaque);
    transform: rotate(90deg);
  }

  @media (max-width: 800px) {
    .masonry-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
    }
    .grande,
    .horizontal {
      grid-column: span 2;
    }
    h1 {
      font-size: 2.2rem;
    }
    #fechar-lightbox {
      top: 1rem;
      right: 1rem;
      font-size: 2rem;
    }
  }
</style>
