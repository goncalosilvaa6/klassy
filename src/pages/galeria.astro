---
// src/pages/galeria.astro
import LayoutBase from "../layouts/LayoutBase.astro";
import { Image } from "astro:assets";

// Importa as tuas fotos reais aqui
import img1 from "../assets/foto.jpeg";
import img2 from "../assets/foto.jpeg";
import img3 from "../assets/foto.jpeg";
import img4 from "../assets/foto.jpeg";
import img5 from "../assets/foto.jpeg";
import img6 from "../assets/foto.jpeg";
---

<LayoutBase titulo="Galeria de Resultados | Klassy">
  <header class="cabecalho-galeria">
    <span class="etiqueta">Portefólio</span>
    <h1>A Excelência em Cada Detalhe</h1>
    <p>Resultados reais que transformam a confiança das nossas clientes.</p>
  </header>

  <section class="container-galeria">
    <div class="masonry-grid">
      <div class="item-galeria grande">
        <Image src={img1} alt="Trabalho de estética detalhado" class="foto" />
        <div class="legenda">Estética Facial</div>
      </div>
      <div class="item-galeria">
        <Image src={img2} alt="Manicure profissional" class="foto" />
        <div class="legenda">Especialidades: Harmonização e Brilho Natural</div>
      </div>
      <div class="item-galeria">
        <Image src={img3} alt="Ambiente do salão" class="foto" />
        <div class="legenda">Especialidades: Harmonização e Brilho Natural</div>
      </div>
      <div class="item-galeria vertical">
        <Image src={img4} alt="Tratamento de corpo" class="foto" />
        <div class="legenda">Especialidades: Harmonização e Brilho Natural</div>
      </div>
      <div class="item-galeria">
        <Image src={img5} alt="Detalhe de verniz gel" class="foto" />
        <div class="legenda">Especialidades: Harmonização e Brilho Natural</div>
      </div>
      <div class="item-galeria horizontal">
        <Image src={img6} alt="Sessão de massagem" class="foto" />
        <div class="legenda">Especialidades: Harmonização e Brilho Natural</div>
      </div>
    </div>
  </section>

  <footer class="cta-galeria">
    <p>Gostou do que viu? Seja a nossa próxima história de sucesso.</p>
    <a href="https://wa.me/teunúmero" class="botao-principal">Marcar Agora</a>
  </footer>
</LayoutBase>

<style>
  .cabecalho-galeria {
    text-align: center;
    padding: 6rem 2rem 4rem;
  }

  .etiqueta {
    color: var(--cor-destaque);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    font-size: 0.8rem;
  }

  h1 {
    font-family: serif;
    font-size: 3rem;
    margin: 1rem 0;
  }

  /* GRID MASONRY (Inspirado no estilo editorial da Klassy) */
  .container-galeria {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-auto-rows: 250px;
    grid-auto-flow: dense;
    gap: 1.5rem;
  }

  .item-galeria {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
  }

  /* Variações de tamanho para o efeito "bonito e profissional" */
  .grande {
    grid-column: span 2;
    grid-row: span 2;
  }
  .vertical {
    grid-row: span 2;
  }
  .horizontal {
    grid-column: span 2;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: block;
  }

  .item-galeria:hover .foto {
    transform: scale(1.08); /* Efeito de luxo ao passar o rato */
  }

  .legenda {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: white;
    padding: 2rem 1.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .item-galeria:hover .legenda {
    opacity: 1;
  }

  .cta-galeria {
    text-align: center;
    background-color: var(--cor-fundo-suave);
    padding: 5rem 2rem;
  }

  @media (max-width: 800px) {
    .masonry-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
    }
    .grande,
    .horizontal {
      grid-column: span 2;
    }
    h1 {
      font-size: 2.2rem;
    }
  }
</style>
