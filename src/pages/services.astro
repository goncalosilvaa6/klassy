---
import LayoutBase from "../layouts/BaseLayout.astro";
import ServicesHero from "../components/sections/ServicesHero.astro";
import ServicesFilter from "../components/sections/ServicesFilter.astro";
import ServicesNails from "../components/sections/ServicesNails.astro";
import ServicesEyes from "../components/sections/ServicesEyes.astro";
import ServicesDepilation from "../components/sections/ServicesDepilation.astro";
import ServicesHair from "../components/sections/ServicesHair.astro";
import ServicesWellness from "../components/sections/ServicesWellness.astro";
import ServicesRental from "../components/sections/ServicesRental.astro";
---

<LayoutBase
  titulo="Serviços de Estética em Valongo | Unhas, Laser & Bem-Estar - Klassy"
  descricao="Menu completo de tratamentos da Klassy em Valongo: Unhas de Gel, Verniz Gel, Laser Díodo, Lash Lifting, Cabelo e Drenagem Renata França. Agende connosco."
>
  <main class="w-full flex flex-col">
    <ServicesHero />
    <ServicesFilter />
    <ServicesNails />
    <ServicesEyes />
    <ServicesDepilation />
    <ServicesHair />
    <ServicesWellness />
    <ServicesRental />
  </main>
</LayoutBase>
