---
import LayoutBase from "../layouts/baselayout.astro";
---

<LayoutBase titulo="Página Não Encontrada | Klassy">
  <section class="erro-404">
    <div class="container-404">
      <h1 class="codigo-erro">404</h1>
      <h2 class="titulo-erro">Página não encontrada</h2>
      <p class="texto-erro">
        O link que tentou aceder não existe ou foi alterado. Não deixe que isso
        atrapalhe o seu momento de cuidado.
      </p>
      <div class="botoes-404">
        <a href="/" class="btn-primario">Voltar ao Início</a>
        <a href="/contact" class="btn-secundario">Agendar Serviço</a>
      </div>
    </div>
  </section>
</LayoutBase>

<style>
  .erro-404 {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    background-color: var(--cor-fundo-suave);
    text-align: center;
    padding: 4rem 2rem;
  }

  .container-404 {
    max-width: 600px;
    animation: fadeUp 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .codigo-erro {
    font-family: serif;
    font-size: 8rem;
    line-height: 1;
    color: var(--cor-destaque);
    margin-bottom: 0.5rem;
    text-shadow: 0 10px 30px rgba(212, 49, 136, 0.15);
  }

  .titulo-erro {
    font-size: 2rem;
    color: var(--cor-texto);
    margin-bottom: 1.5rem;
  }

  .texto-erro {
    color: var(--cor-texto-suave);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .botoes-404 {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primario,
  .btn-secundario {
    padding: 1rem 2.5rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primario {
    background-color: var(--cor-destaque);
    color: white;
    border: 1px solid var(--cor-destaque);
  }

  .btn-primario:hover {
    background-color: var(--cor-destaque-hover);
    border-color: var(--cor-destaque-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(212, 49, 136, 0.2);
  }

  .btn-secundario {
    background-color: transparent;
    color: var(--cor-texto);
    border: 1px solid var(--cor-secundaria);
  }

  .btn-secundario:hover {
    color: var(--cor-destaque);
    border-color: var(--cor-destaque);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .codigo-erro {
      font-size: 6rem;
    }
    .titulo-erro {
      font-size: 1.6rem;
    }
    .botoes-404 {
      flex-direction: column;
      gap: 1rem;
    }
    .btn-primario,
    .btn-secundario {
      width: 100%;
    }
  }
</style>
