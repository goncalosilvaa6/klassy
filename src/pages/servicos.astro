---
// src/pages/servicos.astro
import LayoutBase from "../layouts/LayoutBase.astro";
import { Image } from "astro:assets";

// Importa a imagem de fundo para a secção de workshop
import imgAluguer from "../assets/foto.jpeg";
---

<LayoutBase titulo="Menu de Serviços - Klassy">
  <!-- CABEÇALHO DA PÁGINA -->
  <header class="cabecalho-servicos animar-fade-up">
    <span class="etiqueta-topo">Serviços</span>
    <h1>
      Descubra mais acerca dos nossos<br />Tratamentos de Estética e Beleza
    </h1>
  </header>

  <!-- LISTA DE SERVIÇOS (2 Colunas) -->
  <section class="menu-detalhado animar-fade-up-atraso">
    <div class="coluna-servicos coluna-esq">
      <div class="bloco-servico">
        <h3>Depilação Laser de Díodo</h3>
        <ul>
          <li>Diversas partes do corpo isoladas</li>
          <li>Corpo inteiro</li>
          <li>Zonas específicas do corpo incluindo cara</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Depilação à Linha</h3>
        <ul>
          <li>Sobrancelhas e Buço</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Tratamento Facial e Harmonização</h3>
        <ul>
          <li>Rosto, pescoço e colo</li>
          <li>Preenchimento labial com Ácido Hialurónico</li>
          <li>Tratamento por zona (testa, glabela e pés de galinha)</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Pedicure Verniz Gel</h3>
        <ul>
          <li>Pedicure com verniz gel</li>
          <li>Remoção verniz gel pés + base de tratamento</li>
          <li>Tratamento parafina pés esfoliação + hidratação</li>
        </ul>
      </div>

      <div class="bloco-servico sem-borda-mobile">
        <h3>Unhas de Gel</h3>
        <ul>
          <li>Verniz gel com manicure</li>
          <li>Remoção gel / verniz gel + base de tratamento</li>
          <li>Manutenção de gel</li>
        </ul>
      </div>
    </div>

    <!-- Linha divisória central visível apenas no computador -->
    <div class="divisor-vertical"></div>

    <div class="coluna-servicos coluna-dir">
      <div class="bloco-servico">
        <h3>Depilação Cera Feminina & Masculina</h3>
        <ul>
          <li>Diversas partes do corpo isoladas</li>
          <li>Corpo inteiro</li>
          <li>Zonas específicas do corpo</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Lifting de Pestanas</h3>
        <ul>
          <li>Lifting e coloração de pestanas</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Plástica dos Pés</h3>
        <ul>
          <li>Estimulação da circulação sanguínea</li>
          <li>Pele mais macia e alívio das calosidades</li>
        </ul>
      </div>

      <div class="bloco-servico">
        <h3>Massagens de Bem-Estar</h3>
        <ul>
          <li>Massagem relaxante com técnicas terapêuticas</li>
          <li>Drenagem linfática manual</li>
          <li>Massagem anticelulite / modeladora</li>
        </ul>
      </div>

      <div class="bloco-servico sem-borda">
        <h3>Extensão e Manicure Básica</h3>
        <ul>
          <li>Extensão em Gel e Molde F1</li>
          <li>Manicure com francesinha</li>
          <li>SPA das mãos + tratamento luvas de seda</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SECÇÃO ALUGUER DE ESPAÇO (Workshop) -->
  <section class="aluguer-espaco animar-fade-up-atraso-2">
    <div class="imagem-fundo-wrapper">
      <Image
        src={imgAluguer}
        alt="Detalhe de trabalho de unhas"
        class="foto-preenchimento"
      />
      <div class="camada-escura"></div>
    </div>

    <div class="caixa-aluguer">
      <span class="etiqueta-aluguer">Aluguer de Espaço</span>
      <h2>Sabia que...</h2>
      <p>Pode alugar a nossa sala de Workshop de Nails e Lash Lifting?</p>
      <a href="/contactos" class="botao-principal">Contacte-nos</a>
    </div>
  </section>
</LayoutBase>

<style>
  /* ==========================================================
       ANIMAÇÕES GLOBAIS (CSS PURO)
       ========================================================== */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animar-fade-up {
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
  }

  .animar-fade-up-atraso {
    opacity: 0;
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) 0.2s forwards;
  }

  .animar-fade-up-atraso-2 {
    opacity: 0;
    animation: fadeUp 1s cubic-bezier(0.165, 0.84, 0.44, 1) 0.4s forwards;
  }

  /* ==========================================================
       CABEÇALHO
       ========================================================== */
  .cabecalho-servicos {
    text-align: center;
    padding: 6rem 2rem 4rem;
    background-color: var(--cor-fundo);
  }

  .etiqueta-topo {
    /* Rosa Forte para a etiqueta */
    color: var(--cor-destaque);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    display: block;
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .cabecalho-servicos h1 {
    font-family: serif;
    font-size: 2.8rem;
    color: var(--cor-texto);
    line-height: 1.2;
  }

  /* ==========================================================
       MENU DETALHADO (COLUNAS E LISTAS)
       ========================================================== */
  .menu-detalhado {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
    display: flex;
    position: relative;
  }

  .coluna-servicos {
    flex: 1;
  }

  .coluna-esq {
    padding-right: 3rem;
  }

  .coluna-dir {
    padding-left: 3rem;
  }

  /* O traço fino a separar as colunas no meio */
  .divisor-vertical {
    width: 1px;
    background-color: #eaeaea;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .bloco-servico {
    padding: 1.5rem 0;
    border-bottom: 1px solid #eaeaea;
    transition: transform 0.3s ease;
  }

  /* Efeito subtil ao passar o rato no bloco do serviço */
  .bloco-servico:hover {
    transform: translateX(5px);
  }

  .sem-borda {
    border-bottom: none;
  }

  .bloco-servico h3 {
    font-family: serif;
    font-size: 1.3rem;
    color: var(--cor-texto);
    margin-bottom: 1rem;
    transition: color 0.3s ease;
  }

  .bloco-servico:hover h3 {
    /* O título dos serviços brilha a rosa ao passar o rato */
    color: var(--cor-destaque);
  }

  .bloco-servico ul {
    list-style: none;
    padding-left: 0;
  }

  .bloco-servico li {
    color: var(--cor-texto-suave);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
    position: relative;
    padding-left: 1.2rem;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  /* Bolinha (bullet) customizada elegante */
  .bloco-servico li::before {
    content: "•";
    /* A bolinha fica na cor Dourada Secundária para não pesar demasiado em Rosa */
    color: var(--cor-secundaria);
    font-size: 1.2rem;
    position: absolute;
    left: 0;
    top: -2px;
  }

  /* Efeito de interatividade de luxo na lista */
  .bloco-servico li:hover {
    color: var(--cor-texto);
    transform: translateX(4px);
  }

  /* ==========================================================
       SECÇÃO DE ALUGUER (WORKSHOP)
       ========================================================== */
  .aluguer-espaco {
    position: relative;
    padding: 8rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
    overflow: hidden;
  }

  .imagem-fundo-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .foto-preenchimento {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 10s ease; /* Efeito Ken Burns lento no fundo */
  }

  .aluguer-espaco:hover .foto-preenchimento {
    transform: scale(1.05);
  }

  /* Película semitransparente CORRIGIDA PARA O NOVO TEMA PREMIUM */
  .camada-escura {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Tom escuro e neutro, garantindo que o Dourado e o Rosa da caixa brilham */
    background-color: rgba(15, 15, 15, 0.75);
    z-index: -1;
  }

  .caixa-aluguer {
    background-color: rgba(255, 255, 255, 0.95);
    padding: 4rem;
    text-align: center;
    max-width: 600px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    transition: transform 0.4s ease;
  }

  .caixa-aluguer:hover {
    transform: translateY(-5px);
  }

  .etiqueta-aluguer {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    /* Etiqueta da caixa usa o Dourado para reforçar a ideia de exclusividade (workshop/aluguer) */
    color: var(--cor-secundaria);
    font-weight: 700;
  }

  .caixa-aluguer h2 {
    font-family: serif;
    font-size: 2.5rem;
    margin: 1rem 0;
    color: var(--cor-texto);
  }

  .caixa-aluguer p {
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
    margin-bottom: 2.5rem;
    font-weight: 400;
    line-height: 1.6;
  }

  /* ==========================================================
       RESPONSIVIDADE (TELEMÓVEIS)
       ========================================================== */
  @media (max-width: 900px) {
    .menu-detalhado {
      flex-direction: column;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .coluna-esq,
    .coluna-dir {
      padding-left: 0;
      padding-right: 0;
    }

    .divisor-vertical {
      display: none;
    }

    .sem-borda-mobile {
      border-bottom: 1px solid #eaeaea;
    }

    .cabecalho-servicos h1 {
      font-size: 2.2rem;
    }

    .caixa-aluguer {
      padding: 3rem 1.5rem;
      width: 90%;
    }

    .caixa-aluguer h2 {
      font-size: 2rem;
    }
  }
</style>
