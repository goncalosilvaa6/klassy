---
const anoAtual = new Date().getFullYear();
---

<footer class="relative bg-[var(--cor-fundo-suave)] text-[var(--cor-texto)] overflow-hidden border-t border-[var(--cor-secundaria)]/25">
  <div class="absolute top-0 right-10 w-96 h-96 bg-[var(--cor-destaque)]/5 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-0 left-10 w-96 h-96 bg-[var(--cor-secundaria)]/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-12 z-10">
    <div class="py-16 lg:py-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5 flex flex-col items-start text-left">
        <div class="flex items-center gap-3.5 mb-5">
          <div class="w-10 h-10 rounded-full border border-[var(--cor-secundaria)] flex items-center justify-center bg-white shadow-2xs">
            <span class="font-serif text-lg font-normal text-[var(--cor-destaque)]">
              K
            </span>
          </div>
          <div class="flex flex-col text-left">
            <span class="font-serif text-xl tracking-[0.2em] text-[var(--cor-texto)] font-normal leading-tight">
              KLASSY
            </span>
            <span class="text-[9px] tracking-[0.25em] uppercase text-[var(--cor-texto-suave)]">
              Nails · Beauty · Mind
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-[var(--cor-texto-suave)] font-light leading-relaxed max-w-sm mb-6">
          Desde 2006, em Valongo, cuidamos de si da cabeça aos pés.
          Cabeleireiro, unhas, depilação, olhar e bem-estar num espaço onde cada
          detalhe é pensado para que se sinta especial, confiante e em harmonia
          consigo mesma.
        </p>

        <!-- REDES SOCIAIS COM RASTREIO DATA-REDE-SOCIAL -->
        <div class="flex items-center gap-2.5">
          <!-- Instagram -->
          <a
            data-rede-social="Instagram"
            href="https://www.instagram.com/klassy.pt/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-8 h-8 rounded-full bg-white hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="w-3.5 h-3.5 fill-current"
            >
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>

          <!-- Facebook -->
          <a
            data-rede-social="Facebook"
            href="https://www.facebook.com/klassy.pt"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-8 h-8 rounded-full bg-white hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="w-3.5 h-3.5 fill-current"
            >
              <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z" />
            </svg>
          </a>

          <!-- TikTok -->
          <a
            data-rede-social="TikTok"
            href="https://www.tiktok.com/@klassypt"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="w-8 h-8 rounded-full bg-white hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="w-3.5 h-3.5 fill-current"
            >
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/351919786224"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-8 h-8 rounded-full bg-white hover:bg-emerald-600 border border-[var(--cor-secundaria)]/35 hover:border-emerald-600 text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="w-3.5 h-3.5 fill-current"
            >
              <path d="M.057 24l1.687-6.163A11.867 11.867 0 0 1 .157 11.892C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.48 11.82 11.82 0 0 1 3.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.683-1.448L.057 24zm6.547-3.893l.36.214a9.87 9.87 0 0 0 5.086 1.393c5.449 0 9.885-4.434 9.888-9.884a9.82 9.82 0 0 0-2.893-6.994 9.82 9.82 0 0 0-6.988-2.898c-5.452 0-9.887 4.435-9.888 9.884 0 1.884.524 3.714 1.516 5.289l.235.374-.999 3.65 3.681-.984z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-3 flex flex-col items-start text-left">
        <div class="flex items-center gap-2.5 mb-5">
          <span class="w-4 h-px bg-[var(--cor-secundaria)]"></span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--cor-texto)]">
            Navegação
          </span>
        </div>

        <nav class="flex flex-col gap-2.5 text-xs sm:text-sm text-[var(--cor-texto-suave)] font-light">
          <a
            href="/"
            class="hover:text-[var(--cor-destaque)] transition-colors duration-200"
          >
            Início
          </a>
          <a
            href="/services"
            class="hover:text-[var(--cor-destaque)] transition-colors duration-200"
          >
            Serviços
          </a>
          <a
            href="/about"
            class="hover:text-[var(--cor-destaque)] transition-colors duration-200"
          >
            Sobre Nós
          </a>
          <a
            href="/gallery"
            class="hover:text-[var(--cor-destaque)] transition-colors duration-200"
          >
            Galeria
          </a>
          <a
            href="/contact"
            class="hover:text-[var(--cor-destaque)] transition-colors duration-200"
          >
            Contactos
          </a>
        </nav>
      </div>

      <div class="lg:col-span-4 flex flex-col items-start text-left">
        <div class="flex items-center gap-2.5 mb-5">
          <span class="w-4 h-px bg-[var(--cor-secundaria)]"></span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--cor-texto)]">
            Localização e Contactos
          </span>
        </div>

        <div class="space-y-2 text-xs sm:text-sm text-[var(--cor-texto-suave)] font-light mb-6">
          <p class="leading-relaxed">
            Av. 5 de Outubro 72, Loja N · Edifício Vallis Longus
            <br />
            4440-503 Valongo, Porto
          </p>
          <a
            href="tel:+351919786224"
            class="block text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] font-medium transition-colors"
          >
            +351 919 786 224
          </a>
          <a
            href="mailto:klassypt@gmail.com"
            class="block text-[var(--cor-texto-suave)] hover:text-[var(--cor-destaque)] transition-colors"
          >
            klassypt@gmail.com
          </a>
        </div>

        <a
          href="https://wa.me/351919786224?text=Escreva%20a%20sua%20mensagem..."
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white text-[11px] font-bold uppercase tracking-wider transition-all duration-300 shadow-md shadow-[rgba(212,49,136,0.2)] hover:shadow-lg hover:-translate-y-0.5"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current">
            <path d="M.057 24l1.687-6.163A11.867 11.867 0 0 1 .157 11.892C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.48 11.82 11.82 0 0 1 3.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.683-1.448L.057 24zm6.547-3.893l.36.214a9.87 9.87 0 0 0 5.086 1.393c5.449 0 9.885-4.434 9.888-9.884a9.82 9.82 0 0 0-2.893-6.994 9.82 9.82 0 0 0-6.988-2.898c-5.452 0-9.887 4.435-9.888 9.884 0 1.884.524 3.714 1.516 5.289l.235.374-.999 3.65 3.681-.984z"></path>
          </svg>
          <span>Marcar por whatsapp</span>
        </a>
      </div>
    </div>

    <div class="py-8 border-t border-[var(--cor-secundaria)]/20 flex flex-col lg:flex-row items-center justify-between gap-5 text-xs text-[var(--cor-texto-suave)] font-light">
      <div class="flex flex-col sm:flex-row items-center gap-1 sm:gap-2 text-center sm:text-left">
        <p>
          &copy; {anoAtual} Klassy — Nails, Beauty e Mind. Todos os direitos
          reservados.
        </p>
        <span class="hidden sm:inline text-[var(--cor-secundaria)]">·</span>
        <p>
          Desenvolvido por
          <a
            href="https://partecna.top"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors underline decoration-[var(--cor-secundaria)] underline-offset-2 ml-0.5"
          >
            Partecna
          </a>
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-[11px]">
        <a
          href="/terms"
          class="hover:text-[var(--cor-destaque)] transition-colors"
        >
          Termos e Condições
        </a>
        <span class="text-[var(--cor-secundaria)]/60">·</span>
        <a
          href="/privacy_cookies"
          class="hover:text-[var(--cor-destaque)] transition-colors"
        >
          Privacidade e Cookies
        </a>
        <span class="text-[var(--cor-secundaria)]/60">·</span>
        <a
          href="https://www.livroreclamacoes.pt/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--cor-destaque)] transition-colors"
        >
          Livro de Reclamações
        </a>
      </div>

      <span class="text-center lg:text-right tracking-widest text-[10px] uppercase font-semibold text-[var(--cor-destaque)]">
        Valongo · 2006–{anoAtual}
      </span>
    </div>
  </div>
</footer>
