---
---

<section class="relative bg-[var(--cor-fundo-suave)] py-20 lg:py-32 px-6 lg:px-12 overflow-hidden border-b border-[var(--cor-secundaria)]/20">
  <div class="absolute top-10 right-10 w-96 h-96 bg-[var(--cor-destaque)]/5 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-[var(--cor-secundaria)]/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="relative max-w-7xl mx-auto z-10">
    <div class="flex flex-col items-start text-left mb-14 lg:mb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-[var(--cor-secundaria)]"></span>
        <span class="text-[11px] font-semibold tracking-[0.25em] uppercase text-[var(--cor-texto)]">
          Visite-nos e Contactos
        </span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] text-[var(--cor-texto)] leading-[1.15] tracking-tight max-w-3xl">
        Estamos à sua espera, em{" "}
        <span class="italic font-normal text-[var(--cor-destaque)]">
          Valongo
        </span>
      </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500">
          <div class="flex items-baseline justify-between mb-6 pb-3 border-b border-[var(--cor-secundaria)]/20">
            <h2 class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] font-normal">
              Horário
            </h2>
            <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[var(--cor-texto-suave)]">
              Atendimento
            </span>
          </div>

          <div class="space-y-3.5 text-xs sm:text-sm">
            <div class="flex justify-between items-center text-[var(--cor-texto)] pb-3 border-b border-[var(--cor-secundaria)]/20">
              <span class="font-light">Terça a Sábado</span>
              <span class="font-medium text-[var(--cor-destaque)]">
                09h00 – 19h30
              </span>
            </div>
            <div class="flex justify-between items-center text-[var(--cor-texto-suave)] pt-0.5">
              <span class="font-light">Domingo e Segunda</span>
              <span class="text-[10px] uppercase tracking-[1.5px] font-semibold text-[var(--cor-texto-suave)]">
                Encerrado
              </span>
            </div>
          </div>
        </div>

        <div class="bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500">
          <div class="flex items-baseline justify-between mb-4 pb-3 border-b border-[var(--cor-secundaria)]/20">
            <h2 class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] font-normal">
              Localização
            </h2>
            <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[var(--cor-texto-suave)]">
              Morada
            </span>
          </div>

          <p class="text-xs sm:text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-6">
            Av. 5 de Outubro 72, Loja N<br />
            Edifício Vallis Longus
            <br />
            (ao lado do supermercado Santa Justa)
            <br />
            4440-503 Valongo, Porto
          </p>

          <a
            href="https://maps.google.com/?q=Klassy+Nails+Beauty+Mind+Valongo"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--cor-destaque)] hover:text-[var(--cor-destaque-hover)] transition-colors duration-300"
          >
            <span>Como Chegar</span>
            <span class="text-sm transition-transform duration-300 group-hover:translate-x-1">
              →
            </span>
          </a>
        </div>

        <div class="bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500">
          <div class="flex items-baseline justify-between mb-5 pb-3 border-b border-[var(--cor-secundaria)]/20">
            <h2 class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] font-normal">
              Linha Direta
            </h2>
            <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[var(--cor-texto-suave)]">
              Contacto
            </span>
          </div>

          <div class="space-y-2.5 text-xs sm:text-sm mb-6">
            <a
              href="tel:+351919786224"
              class="block text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] font-medium transition-colors"
            >
              +351 919 786 224
            </a>
            <a
              href="mailto:klassypt@gmail.com"
              class="block text-[var(--cor-texto-suave)] hover:text-[var(--cor-destaque)] font-light transition-colors"
            >
              klassypt@gmail.com
            </a>
          </div>

          <div class="flex items-center gap-2.5 pt-4 border-t border-[var(--cor-secundaria)]/20">
            <a
              href="https://www.instagram.com/klassy.pt/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="w-8 h-8 rounded-full bg-[var(--cor-fundo-suave)] hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/40 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="w-3.5 h-3.5 fill-current"
              >
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
            <a
              href="https://www.facebook.com/klassy.pt"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="w-8 h-8 rounded-full bg-[var(--cor-fundo-suave)] hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/40 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="w-3.5 h-3.5 fill-current"
              >
                <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z" />
              </svg>
            </a>
            <a
              href="https://www.tiktok.com/@klassypt"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              class="w-8 h-8 rounded-full bg-[var(--cor-fundo-suave)] hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/40 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="w-3.5 h-3.5 fill-current"
              >
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
              </svg>
            </a>
            <a
              href="https://wa.me/351919786224"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              class="w-8 h-8 rounded-full bg-[var(--cor-fundo-suave)] hover:bg-[var(--cor-destaque)] border border-[var(--cor-secundaria)]/40 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white flex items-center justify-center transition-all duration-300 shadow-2xs hover:-translate-y-0.5"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="w-3.5 h-3.5 fill-current"
              >
                <path d="M.057 24l1.687-6.163A11.867 11.867 0 0 1 .157 11.892C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.48 11.82 11.82 0 0 1 3.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.683-1.448L.057 24zm6.547-3.893l.36.214a9.87 9.87 0 0 0 5.086 1.393c5.449 0 9.885-4.434 9.888-9.884a9.82 9.82 0 0 0-2.893-6.994 9.82 9.82 0 0 0-6.988-2.898c-5.452 0-9.887 4.435-9.888 9.884 0 1.884.524 3.714 1.516 5.289l.235.374-.999 3.65 3.681-.984z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 h-full min-h-[460px] lg:min-h-[580px] rounded-3xl overflow-hidden border border-[var(--cor-secundaria)]/35 shadow-xl bg-white ring-1 ring-black/5">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3002.4475453363066!2d-8.500237123567883!3d41.19021540820164!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd2463fa38ca0c4d%3A0xe8f854a78a9a29fa!2sKlassy%20-%20Nails%2C%20Beauty%20%26%20Mind%20-%20Centro%20de%20Est%C3%A9tica%20%7C%20Tu%2B%20Bonita!5e0!3m2!1spt-PT!2spt!4v1780437611756!5m2!1spt-PT!2spt"
          class="w-full h-full min-h-[460px] lg:min-h-[580px] border-0 block"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização da Klassy em Valongo no Google Maps"
        ></iframe>
      </div>
    </div>
  </div>
</section>
