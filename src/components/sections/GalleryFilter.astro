---

---

<nav
  aria-label="Filtrar trabalhos da galeria"
  class="sticky top-16 sm:top-20 z-30 bg-[var(--cor-fundo-suave)]/95 backdrop-blur-md border-y border-[var(--cor-secundaria)]/25 py-3 px-6 shadow-xs"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-start lg:justify-center gap-2 sm:gap-2.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden scroll-smooth"
  >
    <button
      type="button"
      data-filter="all"
      class="filtro-btn inline-flex items-center px-5 py-2 rounded-full bg-[var(--cor-destaque)] text-white border border-[var(--cor-destaque)] text-[11px] font-semibold tracking-wider uppercase whitespace-nowrap shadow-2xs transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
    >
      <span>Todos os Trabalhos</span>
    </button>

    <button
      type="button"
      data-filter="unhas"
      class="filtro-btn inline-flex items-center px-5 py-2 rounded-full bg-white hover:bg-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[11px] font-semibold tracking-wider uppercase whitespace-nowrap shadow-2xs transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
    >
      <span>Unhas &amp; Nail Design</span>
    </button>

    <button
      type="button"
      data-filter="facial"
      class="filtro-btn inline-flex items-center px-5 py-2 rounded-full bg-white hover:bg-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[11px] font-semibold tracking-wider uppercase whitespace-nowrap shadow-2xs transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
    >
      <span>Estética Facial</span>
    </button>

    <button
      type="button"
      data-filter="corpo"
      class="filtro-btn inline-flex items-center px-5 py-2 rounded-full bg-white hover:bg-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[11px] font-semibold tracking-wider uppercase whitespace-nowrap shadow-2xs transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
    >
      <span>Corpo &amp; Bem-Estar</span>
    </button>

    <button
      type="button"
      data-filter="espaco"
      class="filtro-btn inline-flex items-center px-5 py-2 rounded-full bg-white hover:bg-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-white border border-[var(--cor-secundaria)]/35 hover:border-[var(--cor-destaque)] text-[11px] font-semibold tracking-wider uppercase whitespace-nowrap shadow-2xs transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
    >
      <span>O Nosso Espaço</span>
    </button>
  </div>
</nav>

<script>
  function setupGalleryFilter() {
    const botoes = document.querySelectorAll<HTMLButtonElement>(".filtro-btn");
    const itens = document.querySelectorAll<HTMLElement>("[data-category]");

    botoes.forEach((botao) => {
      botao.addEventListener("click", () => {
        const filtro = botao.getAttribute("data-filter");

        botoes.forEach((b) => {
          b.classList.remove(
            "bg-[var(--cor-destaque)]",
            "text-white",
            "border-[var(--cor-destaque)]",
          );
          b.classList.add(
            "bg-white",
            "text-[var(--cor-texto)]",
            "border-[var(--cor-secundaria)]/35",
          );
        });

        botao.classList.remove(
          "bg-white",
          "text-[var(--cor-texto)]",
          "border-[var(--cor-secundaria)]/35",
        );
        botao.classList.add(
          "bg-[var(--cor-destaque)]",
          "text-white",
          "border-[var(--cor-destaque)]",
        );

        itens.forEach((item) => {
          const categoria = item.getAttribute("data-category");
          if (filtro === "all" || categoria === filtro) {
            item.classList.remove("hidden");
            item.classList.add("flex");
          } else {
            item.classList.add("hidden");
            item.classList.remove("flex");
          }
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupGalleryFilter);
  } else {
    setupGalleryFilter();
  }

  document.addEventListener("astro:page-load", setupGalleryFilter);
</script>
