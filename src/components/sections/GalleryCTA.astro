---

---

<section
  class="relative bg-white py-20 lg:py-28 px-6 lg:px-12 text-center overflow-hidden border-t border-[var(--cor-secundaria)]/20"
>
  <!-- GLOW SUAVE ROSA NO FUNDO BRANCO -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[var(--cor-destaque)]/5 rounded-full blur-3xl pointer-events-none -z-0"
  >
  </div>

  <div class="relative max-w-3xl mx-auto z-10">
    <!-- Título Principal -->
    <h2
      class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[var(--cor-texto)] mb-5 leading-tight tracking-tight"
    >
      Pronta para o teu momento <span class="italic text-[var(--cor-destaque)]"
        >Klassy</span
      >?
    </h2>

    <!-- Subtítulo -->
    <p
      class="text-sm sm:text-base text-[var(--cor-texto-suave)] font-light leading-relaxed max-w-xl mx-auto mb-10"
    >
      Marca já a tua hora — respondemos no WhatsApp em minutos. A tua próxima
      saída <em
        class="not-italic text-[var(--cor-destaque)] font-serif italic font-medium"
        >tu+ bonita</em
      > começa aqui.
    </p>

    <!-- BOTÕES PÍLULA (WHATSAPP + TELEMÓVEL) -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <!-- Botão WhatsApp -->
      <a
        href="https://wa.me/351919786224?text=Ol%C3%A1!+Gostaria+de+marcar+um+hor%C3%A1rio+na+Klassy."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md shadow-[rgba(212,49,136,0.25)] hover:shadow-lg hover:shadow-[rgba(212,49,136,0.35)] hover:-translate-y-0.5"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current">
          <path
            d="M.057 24l1.687-6.163A11.867 11.867 0 0 1 .157 11.892C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.48 11.82 11.82 0 0 1 3.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.683-1.448L.057 24zm6.547-3.893l.36.214a9.87 9.87 0 0 0 5.086 1.393c5.449 0 9.885-4.434 9.888-9.884a9.82 9.82 0 0 0-2.893-6.994 9.82 9.82 0 0 0-6.988-2.898c-5.452 0-9.887 4.435-9.888 9.884 0 1.884.524 3.714 1.516 5.289l.235.374-.999 3.65 3.681-.984z"
          ></path>
        </svg>
        <span>Marcar por WhatsApp</span>
      </a>

      <!-- Botão Telemóvel -->
      <a
        href="tel:+351919786224"
        class="inline-flex items-center gap-3 px-7 py-4 rounded-full bg-white hover:bg-[var(--cor-fundo-suave)] border border-[var(--cor-secundaria)] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] hover:border-[var(--cor-destaque)] text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-xs hover:-translate-y-0.5 hover:shadow-sm"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-4 h-4 fill-none stroke-[var(--cor-secundaria)] stroke-2 stroke-linecap-round stroke-linejoin-round"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        <span>+351 919 786 224</span>
      </a>
    </div>
  </div>
</section>
