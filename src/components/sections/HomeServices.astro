---

---

<section
  class="relative py-24 sm:py-32 px-6 lg:px-12 bg-[var(--cor-fundo-suave)] overflow-hidden border-t border-[var(--cor-secundaria)]/20"
>
  <!-- GLOW DECORATIVO SUAVE -->
  <div
    class="absolute top-1/4 right-5 w-96 h-96 bg-[var(--cor-destaque)]/5 rounded-full blur-3xl pointer-events-none -z-0"
  >
  </div>
  <div
    class="absolute bottom-10 left-10 w-80 h-80 bg-[var(--cor-secundaria)]/10 rounded-full blur-3xl pointer-events-none -z-0"
  >
  </div>

  <div class="relative max-w-7xl mx-auto z-10">
    <!-- CABEÇALHO DA SECÇÃO -->
    <div
      class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 lg:mb-20"
    >
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--cor-destaque)]/10 border border-[var(--cor-destaque)]/20 mb-5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--cor-destaque)]"></span>
        <span
          class="text-[var(--cor-destaque)] font-bold tracking-[2px] uppercase text-[11px]"
        >
          Pilares de Excelência
        </span>
      </div>

      <h2
        class="font-serif text-3xl sm:text-4xl lg:text-[2.75rem] text-[var(--cor-texto)] leading-tight mb-4 tracking-tight"
      >
        Tratamentos criados para realçar a sua <span
          class="italic text-[var(--cor-destaque)]">melhor versão</span
        >
      </h2>

      <p
        class="text-base sm:text-lg text-[var(--cor-texto-suave)] font-light leading-relaxed"
      >
        Uma seleção pensada ao pormenor, onde a tecnologia avançada se cruza com
        o atendimento acolhedor.
      </p>
    </div>

    <!-- GRELHA DE 4 SERVIÇOS DE ASSINATURA -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 items-stretch mb-16"
    >
      <!-- Pilar 1: Unhas & Nail Design -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <div class="flex justify-between items-center mb-6">
            <span
              class="font-serif text-2xl text-[var(--cor-secundaria)] font-light"
              >01</span
            >
            <span
              class="w-10 h-10 rounded-full bg-[var(--cor-destaque)]/10 text-[var(--cor-destaque)] flex items-center justify-center text-base transition-transform duration-300 group-hover:scale-110"
              >💅</span
            >
          </div>

          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] mb-3 leading-snug"
          >
            Unhas de Gel &amp; Nail Art
          </h3>

          <p
            class="text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-6"
          >
            Estrutura perfeita, manicure combinada e acabamentos duradouros com
            materiais certificados e resistentes.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="text-xs uppercase tracking-wider text-[var(--cor-texto-suave)] font-medium"
            >Gel • Verniz • Extensão</span
          >
          <span
            class="text-[var(--cor-destaque)] text-sm transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </div>
      </div>

      <!-- Pilar 2: Laser Díodo -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <div class="flex justify-between items-center mb-6">
            <span
              class="font-serif text-2xl text-[var(--cor-secundaria)] font-light"
              >02</span
            >
            <span
              class="w-10 h-10 rounded-full bg-[var(--cor-secundaria)]/15 text-[var(--cor-secundaria)] flex items-center justify-center text-base transition-transform duration-300 group-hover:scale-110"
              >⚡</span
            >
          </div>

          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] mb-3 leading-snug"
          >
            Depilação Laser Díodo
          </h3>

          <p
            class="text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-6"
          >
            Resultados visíveis logo nas primeiras sessões, com conforto térmico
            e eficácia em zonas corporais ou de rosto.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="text-xs uppercase tracking-wider text-[var(--cor-texto-suave)] font-medium"
            >Corpo • Rosto • Zonas</span
          >
          <span
            class="text-[var(--cor-destaque)] text-sm transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </div>
      </div>

      <!-- Pilar 3: Estética Facial -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <div class="flex justify-between items-center mb-6">
            <span
              class="font-serif text-2xl text-[var(--cor-secundaria)] font-light"
              >03</span
            >
            <span
              class="w-10 h-10 rounded-full bg-[var(--cor-destaque)]/10 text-[var(--cor-destaque)] flex items-center justify-center text-base transition-transform duration-300 group-hover:scale-110"
              >✨</span
            >
          </div>

          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] mb-3 leading-snug"
          >
            Estética Facial Avançada
          </h3>

          <p
            class="text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-6"
          >
            Limpezas de pele profundas, regeneração celular, hidratação
            intensiva e rituais rejuvenescedores.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="text-xs uppercase tracking-wider text-[var(--cor-texto-suave)] font-medium"
            >Limpeza • Ácido Hialurónico</span
          >
          <span
            class="text-[var(--cor-destaque)] text-sm transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </div>
      </div>

      <!-- Pilar 4: Massagens & Bem-Estar -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <div class="flex justify-between items-center mb-6">
            <span
              class="font-serif text-2xl text-[var(--cor-secundaria)] font-light"
              >04</span
            >
            <span
              class="w-10 h-10 rounded-full bg-[var(--cor-secundaria)]/15 text-[var(--cor-secundaria)] flex items-center justify-center text-base transition-transform duration-300 group-hover:scale-110"
              >🌿</span
            >
          </div>

          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] mb-3 leading-snug"
          >
            Massagens &amp; Bem-Estar
          </h3>

          <p
            class="text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-6"
          >
            Drenagem linfática manual, alívio de tensões, modelação e momentos
            desenhados para restaurar o equilíbrio do corpo.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="text-xs uppercase tracking-wider text-[var(--cor-texto-suave)] font-medium"
            >Drenagem • Relaxamento</span
          >
          <span
            class="text-[var(--cor-destaque)] text-sm transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </div>
      </div>
    </div>

    <!-- BOTÃO DE EXPLORAR O MENU COMPLETO -->
    <div class="text-center">
      <a
        href="/services"
        class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white hover:bg-[var(--cor-fundo-suave)] border border-[var(--cor-secundaria)] text-[var(--cor-texto)] text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow-md hover:border-[var(--cor-destaque)] hover:text-[var(--cor-destaque)] hover:-translate-y-0.5"
      >
        <span>Explorar Lista Completa de Serviços</span>
        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
          >→</span
        >
      </a>
    </div>
  </div>
</section>
