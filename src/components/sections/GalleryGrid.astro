---
import { Image } from "astro:assets";
import img1 from "../../assets/foto.jpeg";
import img2 from "../../assets/foto.jpeg";
import img3 from "../../assets/foto.jpeg";
import img4 from "../../assets/foto.jpeg";
import img5 from "../../assets/foto.jpeg";
import img6 from "../../assets/foto.jpeg";

const fotos = [
  {
    src: img1,
    categoria: "facial",
    tag: "Estética Facial",
    titulo: "Limpeza de Pele Profunda",
    extra: false,
  },
  {
    src: img2,
    categoria: "unhas",
    tag: "Nail Design",
    titulo: "Unhas de Gel & Formato Oval",
    extra: false,
  },
  {
    src: img3,
    categoria: "espaco",
    tag: "O Nosso Espaço",
    titulo: "Ambiente Acolhedor em Valongo",
    extra: false,
  },
  {
    src: img4,
    categoria: "corpo",
    tag: "Corpo & Bem-Estar",
    titulo: "Drenagem Linfática Manual",
    extra: false,
  },
  {
    src: img5,
    categoria: "unhas",
    tag: "Nail Design",
    titulo: "Verniz Gel de Alta Durabilidade",
    extra: false,
  },
  {
    src: img6,
    categoria: "corpo",
    tag: "Massagens",
    titulo: "Massagem de Relaxamento",
    extra: false,
  },
  {
    src: img1,
    categoria: "facial",
    tag: "Sobrancelhas & Cílios",
    titulo: "Lash Lifting & Coloração",
    extra: false,
  },
  {
    src: img2,
    categoria: "unhas",
    tag: "Nail Art",
    titulo: "Francesinha Fina & Cromados",
    extra: false,
  },
  {
    src: img3,
    categoria: "espaco",
    tag: "O Nosso Espaço",
    titulo: "Gabinete de Estética Avançada",
    extra: true,
  },
  {
    src: img5,
    categoria: "unhas",
    tag: "Nail Design",
    titulo: "Unhas de Imersão em Pó",
    extra: true,
  },
  {
    src: img1,
    categoria: "facial",
    tag: "Estética Facial",
    titulo: "Regeneração & Hidratação",
    extra: true,
  },
  {
    src: img4,
    categoria: "corpo",
    tag: "Corpo & Bem-Estar",
    titulo: "Método Renata França",
    extra: true,
  },
];
---

<section class="bg-[var(--cor-fundo-suave)] py-12 lg:py-20 px-6 lg:px-12">
  <div class="max-w-7xl mx-auto">
    <div
      id="galeria-grid"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6"
    >
      {
        fotos.map((item) => (
          <div
            data-category={item.categoria}
            data-src={item.src.src}
            class={`item-galeria trigger-lightbox group relative aspect-[4/5] overflow-hidden rounded-2xl bg-white shadow-2xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.08)] border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 transition-all duration-500 hover:-translate-y-1 cursor-pointer ${item.extra ? "item-extra hidden" : "flex"}`}
          >
            <Image
              src={item.src}
              alt={item.titulo}
              class="w-full h-full object-cover block transition-transform duration-700 ease-out group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
              <span class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                <svg
                  viewBox="0 0 24 24"
                  class="w-4 h-4 fill-none stroke-current stroke-[1.5]"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="7" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  <line x1="11" y1="8" x2="11" y2="14" />
                  <line x1="8" y1="11" x2="14" y2="11" />
                </svg>
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 flex flex-col justify-end translate-y-2 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none">
              <span class="text-[9px] font-semibold uppercase tracking-[2px] text-[var(--cor-secundaria)] mb-1">
                {item.tag}
              </span>
              <h3 class="font-serif text-xs sm:text-sm text-white font-medium line-clamp-1 leading-snug">
                {item.titulo}
              </h3>
            </div>
          </div>
        ))
      }
    </div>

    <div id="container-ver-mais" class="text-center mt-12 sm:mt-16">
      <button
        id="btn-ver-mais"
        type="button"
        class="group inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-white hover:bg-[var(--cor-fundo-suave)] border border-[var(--cor-secundaria)] text-[var(--cor-texto)] text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-2xs hover:border-[var(--cor-destaque)] hover:text-[var(--cor-destaque)] hover:-translate-y-0.5 cursor-pointer"
      >
        <span>Ver Mais Fotografias</span>
        <span
          class="text-sm transition-transform duration-300 group-hover:translate-y-0.5"
          >↓</span
        >
      </button>
    </div>
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Visualizador de imagem em detalhe"
  >
    <button
      id="fechar-lightbox"
      type="button"
      aria-label="Fechar galeria"
      class="absolute top-6 right-6 w-11 h-11 rounded-full bg-white/10 hover:bg-[var(--cor-destaque)] border border-white/20 text-white flex items-center justify-center transition-all duration-300 hover:rotate-90 cursor-pointer"
    >
      <svg
        viewBox="0 0 24 24"
        class="w-5 h-5 stroke-current fill-none stroke-[1.5]"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="relative max-w-4xl max-h-[85vh] rounded-2xl overflow-hidden shadow-2xl border border-white/15"
    >
      <img
        id="imagem-lightbox"
        src=""
        alt="Trabalho em detalhe"
        class="w-full h-full max-h-[85vh] object-contain block"
      />
    </div>
  </div>
</section>

<script>
  function setupGalleryGrid() {
    const triggers =
      document.querySelectorAll<HTMLElement>(".trigger-lightbox");
    const lightbox = document.getElementById(
      "lightbox",
    ) as HTMLDivElement | null;
    const lightboxImg = document.getElementById(
      "imagem-lightbox",
    ) as HTMLImageElement | null;
    const fecharBtn = document.getElementById(
      "fechar-lightbox",
    ) as HTMLButtonElement | null;

    const btnVerMais = document.getElementById(
      "btn-ver-mais",
    ) as HTMLButtonElement | null;
    const containerVerMais = document.getElementById(
      "container-ver-mais",
    ) as HTMLDivElement | null;
    const extras = document.querySelectorAll<HTMLElement>(".item-extra");

    if (btnVerMais && containerVerMais) {
      btnVerMais.addEventListener("click", () => {
        extras.forEach((item) => {
          item.classList.remove("hidden");
          item.classList.add("flex");
        });
        containerVerMais.classList.add("hidden");
      });
    }

    if (lightbox && lightboxImg && fecharBtn) {
      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const src = trigger.getAttribute("data-src");
          if (src) {
            lightboxImg.src = src;
            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            document.body.style.overflow = "hidden";
          }
        });
      });

      const fechar = () => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightboxImg.src = "";
        document.body.style.overflow = "";
      };

      fecharBtn.addEventListener("click", fechar);

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) {
          fechar();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
          fechar();
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupGalleryGrid);
  } else {
    setupGalleryGrid();
  }

  document.addEventListener("astro:page-load", setupGalleryGrid);
</script>
