<section
  id="aluguer"
  class="bg-[var(--cor-fundo-suave)] pb-24 lg:pb-32 pt-8 px-6 lg:px-12 scroll-mt-36"
>
  <div class="max-w-7xl mx-auto">
    <div
      class="relative overflow-hidden rounded-3xl bg-[#181115] border border-[var(--cor-secundaria)]/30 text-white p-8 sm:p-12 lg:p-16 shadow-2xl"
    >
      <div
        class="absolute -top-12 -right-12 w-80 h-80 bg-[var(--cor-destaque)]/20 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <div class="relative z-10 max-w-3xl">
        <span
          class="inline-block text-[10px] font-bold uppercase tracking-[2px] text-[var(--cor-secundaria)] mb-4"
        >
          Espaço Profissional &amp; Coworking
        </span>

        <h2
          class="font-serif text-3xl sm:text-4xl text-white mb-5 leading-tight"
        >
          Aluguer de Cadeira e Mesa de Trabalho
        </h2>

        <p
          class="text-sm sm:text-base text-white/80 leading-relaxed font-light mb-8"
