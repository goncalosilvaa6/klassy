---

<section
  id="depilacao"
  class="bg-[var(--cor-fundo-suave)] pt-12 pb-12 px-6 lg:px-12 scroll-mt-28 sm:scroll-mt-36"
>
  <div class="max-w-7xl mx-auto">
    <div
      class="flex items-start gap-4 sm:gap-5 mb-10 pb-6 border-b border-[var(--cor-secundaria)]/25"
    >
      <span
        class="font-serif text-3xl sm:text-4xl text-[var(--cor-secundaria)] font-light leading-none"
        >03</span
      >
      <div>
        <h2
          class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[var(--cor-texto)] leading-tight mb-1.5"
        >
          Depilação Laser &amp; Cera
        </h2>
        <p class="text-xs sm:text-sm text-[var(--cor-texto-suave)] font-light">
          Tecnologia avançada de díodo e cera morna para senhoras e homens
        </p>
      </div>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7 items-stretch"
    >
      <div
        class="group relative bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <span
          class="absolute -top-3 right-7 bg-white border border-[var(--cor-secundaria)] text-[var(--cor-destaque)] text-[9px] font-semibold tracking-[0.2em] uppercase px-3.5 py-1 rounded-full shadow-xs"
        >
          Destaque
        </span>

        <div>
          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] group-hover:text-[var(--cor-destaque)] transition-colors duration-300 mb-1.5 leading-snug"
          >
            Laser Díodo — Packs &amp; Total
          </h3>
          <p
            class="text-[10px] font-semibold text-[var(--cor-destaque)] uppercase tracking-[1.5px] mb-3"
          >
            Pack 3 Zonas · Corpo Inteiro
          </p>
          <p
            class="text-xs sm:text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-8"
          >
            Tratamento integral para Mulher ou Homem com tecnologia de ponteira
            refrigerada. Inclui opções de Pack 3 Zonas e sessões combinadas.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <div
            class="flex items-center gap-1.5 text-xs text-[var(--cor-texto-suave)] font-light"
          >
            <svg
              viewBox="0 0 24 24"
              class="w-3.5 h-3.5 stroke-current fill-none stroke-[1.5]"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>45–60 min</span>
          </div>
          <a
            href="https://wa.me/351919786224?text=Ol%C3%A1%2C+gostaria+de+marcar+Laser+D%C3%ADodo+Pack+na+Klassy."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--cor-destaque)] group-hover:text-[var(--cor-destaque-hover)] transition-transform duration-300 group-hover:translate-x-1"
          >
            <span>Marcar</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div
        class="group relative bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] group-hover:text-[var(--cor-destaque)] transition-colors duration-300 mb-1.5 leading-snug"
          >
            Laser Díodo — Zonas Isoladas
          </h3>
          <p
            class="text-[10px] font-semibold text-[var(--cor-secundaria)] uppercase tracking-[1.5px] mb-3"
          >
            Corpo &amp; Rosto
          </p>
          <p
            class="text-xs sm:text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-8"
          >
            Sessões específicas: Axila, Virilha, Meia Perna, Rosto, Barriga,
            Costas, Peito, Linha Alba ou Perianal.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <div
            class="flex items-center gap-1.5 text-xs text-[var(--cor-texto-suave)] font-light"
          >
            <svg
              viewBox="0 0 24 24"
              class="w-3.5 h-3.5 stroke-current fill-none stroke-[1.5]"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>15–30 min</span>
          </div>
          <a
            href="https://wa.me/351919786224?text=Ol%C3%A1%2C+gostaria+de+marcar+uma+zona+de+Laser+na+Klassy."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--cor-destaque)] group-hover:text-[var(--cor-destaque-hover)] transition-transform duration-300 group-hover:translate-x-1"
          >
            <span>Marcar</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div
        class="group relative bg-white/95 backdrop-blur-sm p-7 sm:p-8 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-xs hover:shadow-2xl hover:shadow-[rgba(212,49,136,0.06)] transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <h3
            class="font-serif text-xl sm:text-2xl text-[var(--cor-texto)] group-hover:text-[var(--cor-destaque)] transition-colors duration-300 mb-1.5 leading-snug"
          >
            Epilação a Cera
          </h3>
          <p
            class="text-[10px] font-semibold text-[var(--cor-texto-suave)] uppercase tracking-[1.5px] mb-3"
          >
            Feminina &amp; Masculina
          </p>
          <p
            class="text-xs sm:text-sm text-[var(--cor-texto-suave)] leading-relaxed font-light mb-8"
          >
            Cera morna hipoalergénica: Perna Inteira, Meia Perna, Virilha
            Total/Bikini, Axila, Peito, Sobrancelha, Buço e Queixo.
          </p>
        </div>

        <div
          class="pt-4 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <div
            class="flex items-center gap-1.5 text-xs text-[var(--cor-texto-suave)] font-light"
          >
            <svg
              viewBox="0 0 24 24"
              class="w-3.5 h-3.5 stroke-current fill-none stroke-[1.5]"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>15–50 min</span>
          </div>
          <a
            href="https://wa.me/351919786224?text=Ol%C3%A1%2C+gostaria+de+marcar+Depila%C3%A7%C3%A3o+a+Cera+na+Klassy."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--cor-destaque)] group-hover:text-[var(--cor-destaque-hover)] transition-transform duration-300 group-hover:translate-x-1"
          >
            <span>Marcar</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
