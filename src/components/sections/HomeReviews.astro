---

---

<section
  class="relative py-24 sm:py-32 px-6 lg:px-12 bg-[var(--cor-fundo-suave)] overflow-hidden border-t border-[var(--cor-secundaria)]/20"
>
  <!-- GLOW SUAVE DECORATIVO DE FUNDO -->
  <div
    class="absolute top-1/2 left-10 w-96 h-96 bg-[var(--cor-destaque)]/5 rounded-full blur-3xl pointer-events-none -z-0"
  >
  </div>
  <div
    class="absolute top-10 right-10 w-80 h-80 bg-[var(--cor-secundaria)]/10 rounded-full blur-3xl pointer-events-none -z-0"
  >
  </div>

  <div class="relative max-w-7xl mx-auto z-10">
    <!-- CABEÇALHO DA SECÇÃO -->
    <div
      class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 lg:mb-20"
    >
      <!-- Tag / Eyebrow -->
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--cor-destaque)]/10 border border-[var(--cor-destaque)]/20 mb-5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--cor-destaque)]"></span>
        <span
          class="text-[var(--cor-destaque)] font-bold tracking-[2px] uppercase text-[11px]"
        >
          Experiências Reais
        </span>
      </div>

      <!-- Título Principal -->
      <h2
        class="font-serif text-3xl sm:text-4xl lg:text-[2.75rem] text-[var(--cor-texto)] leading-tight mb-4 tracking-tight"
      >
        O que dizem as nossas <span class="italic text-[var(--cor-destaque)]"
          >clientes</span
        >
      </h2>

      <!-- Subtítulo -->
      <p
        class="text-base sm:text-lg text-[var(--cor-texto-suave)] font-light leading-relaxed"
      >
        Histórias genuínas de quem confia na Klassy para os seus momentos únicos
        de cuidado, beleza e bem-estar.
      </p>
    </div>

    <!-- GRELHA DE TESTEMUNHOS (3 CARTÕES EDITORIAIS) -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch"
    >
      <!-- Cartão 1 -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <!-- Topo do Cartão: Estrelas + Badge Google -->
          <div class="flex justify-between items-center mb-6">
            <div
              class="flex items-center gap-1 text-[var(--cor-secundaria)] text-base tracking-widest"
            >
              <span>★</span><span>★</span><span>★</span><span>★</span><span
                >★</span
              >
            </div>
            <div
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200/80 shadow-2xs"
            >
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                ></path>
              </svg>
              <span
                class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider"
                >Google</span
              >
            </div>
          </div>

          <!-- Texto do Testemunho -->
          <p
            class="text-[var(--cor-texto)] text-sm sm:text-base leading-relaxed font-light italic mb-8"
          >
            "A melhor limpeza de pele que já fiz. O espaço é lindíssimo e super
            acolhedor. O atendimento é muito profissional. Recomendo de olhos
            fechados!"
          </p>
        </div>

        <!-- Assinatura da Cliente -->
        <div
          class="pt-5 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="font-serif text-sm font-semibold tracking-wide text-[var(--cor-texto)]"
          >
            Maria Santos
          </span>
          <span
            class="text-[11px] font-medium text-[var(--cor-destaque)] tracking-wider uppercase"
          >
            Cliente Verificada
          </span>
        </div>
      </div>

      <!-- Cartão 2 -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <!-- Topo do Cartão: Estrelas + Badge Google -->
          <div class="flex justify-between items-center mb-6">
            <div
              class="flex items-center gap-1 text-[var(--cor-secundaria)] text-base tracking-widest"
            >
              <span>★</span><span>★</span><span>★</span><span>★</span><span
                >★</span
              >
            </div>
            <div
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200/80 shadow-2xs"
            >
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                ></path>
              </svg>
              <span
                class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider"
                >Google</span
              >
            </div>
          </div>

          <!-- Texto do Testemunho -->
          <p
            class="text-[var(--cor-texto)] text-sm sm:text-base leading-relaxed font-light italic mb-8"
          >
            "Sou cliente de unhas de gel há 2 anos e o trabalho é sempre
            impecável. Duram semanas sem levantar e o ambiente é fantástico para
            relaxar."
          </p>
        </div>

        <!-- Assinatura da Cliente -->
        <div
          class="pt-5 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="font-serif text-sm font-semibold tracking-wide text-[var(--cor-texto)]"
          >
            Ana Rita Freitas
          </span>
          <span
            class="text-[11px] font-medium text-[var(--cor-destaque)] tracking-wider uppercase"
          >
            Cliente Verificada
          </span>
        </div>
      </div>

      <!-- Cartão 3 -->
      <div
        class="group relative bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-3xl border border-[var(--cor-secundaria)]/30 hover:border-[var(--cor-destaque)]/40 shadow-sm hover:shadow-xl hover:shadow-[rgba(212,49,136,0.08)] transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
      >
        <div>
          <!-- Topo do Cartão: Estrelas + Badge Google -->
          <div class="flex justify-between items-center mb-6">
            <div
              class="flex items-center gap-1 text-[var(--cor-secundaria)] text-base tracking-widest"
            >
              <span>★</span><span>★</span><span>★</span><span>★</span><span
                >★</span
              >
            </div>
            <div
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-50 border border-gray-200/80 shadow-2xs"
            >
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                ></path>
              </svg>
              <span
                class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider"
                >Google</span
              >
            </div>
          </div>

          <!-- Texto do Testemunho -->
          <p
            class="text-[var(--cor-texto)] text-sm sm:text-base leading-relaxed font-light italic mb-8"
          >
            "Fiz depilação a laser e os resultados notaram-se logo na primeira
            sessão. Muito conforto no processo e uma simpatia incrível por parte
            da equipa."
          </p>
        </div>

        <!-- Assinatura da Cliente -->
        <div
          class="pt-5 border-t border-[var(--cor-secundaria)]/20 flex items-center justify-between"
        >
          <span
            class="font-serif text-sm font-semibold tracking-wide text-[var(--cor-texto)]"
          >
            Joana Silva
          </span>
          <span
            class="text-[11px] font-medium text-[var(--cor-destaque)] tracking-wider uppercase"
          >
            Cliente Verificada
          </span>
        </div>
      </div>
    </div>

    <!-- BOTÃO FINAL PARA VER TODAS NO GOOGLE -->
    <div class="text-center mt-14 sm:mt-16">
      <a
        href="https://www.google.com/search?q=Klassy+-+Nails,+Beauty+%26+Mind"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white hover:bg-[var(--cor-fundo-suave)] border border-[var(--cor-secundaria)] text-[var(--cor-texto)] text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow-md hover:border-[var(--cor-destaque)] hover:text-[var(--cor-destaque)] hover:-translate-y-0.5"
      >
        <span>Ver todas as avaliações no Google</span>
        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
          >↗</span
        >
      </a>
    </div>
  </div>
</section>
