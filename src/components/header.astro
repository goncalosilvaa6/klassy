---

---

<header
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-[var(--cor-secundaria)]/25 transition-all duration-300"
>
  <div
    class="max-w-7xl mx-auto px-6 lg:px-12 py-3.5 sm:py-4 flex items-center justify-between relative"
  >
    <input
      type="checkbox"
      id="menu-toggle"
      class="peer hidden"
      aria-label="Abrir menu de navegação"
    />

    <nav class="hidden lg:flex items-center gap-8 flex-1 justify-start">
      <a
        href="/about"
        class="group relative text-xs font-semibold uppercase tracking-[2px] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors duration-200 py-1"
      >
        <span>A Klassy</span>
        <span
          class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-[var(--cor-destaque)] transition-all duration-300 group-hover:w-full"
        ></span>
      </a>

      <a
        href="/services"
        class="group relative text-xs font-semibold uppercase tracking-[2px] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors duration-200 py-1"
      >
        <span>Serviços</span>
        <span
          class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-[var(--cor-destaque)] transition-all duration-300 group-hover:w-full"
        ></span>
      </a>
    </nav>

    <div class="flex justify-center shrink-0">
      <a
        href="/"
        class="group flex flex-col items-center text-center transition-transform duration-300 hover:scale-105"
        aria-label="Klassy - Voltar à Página Inicial"
      >
        <span
          class="font-serif text-2xl sm:text-[1.75rem] font-bold tracking-[3px] sm:tracking-[4px] text-[var(--cor-destaque)] leading-none"
        >
          KLASSY
        </span>
        <span
          class="text-[8px] sm:text-[9px] font-medium tracking-[2.5px] uppercase text-[var(--cor-texto-suave)] group-hover:text-[var(--cor-destaque)] transition-colors mt-1"
        >
          Nails · Beauty · Mind
        </span>
      </a>
    </div>

    <nav class="hidden lg:flex items-center gap-7 xl:gap-8 flex-1 justify-end">
      <a
        href="/gallery"
        class="group relative text-xs font-semibold uppercase tracking-[2px] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors duration-200 py-1"
      >
        <span>Portefólio</span>
        <span
          class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-[var(--cor-destaque)] transition-all duration-300 group-hover:w-full"
        ></span>
      </a>

      <a
        href="/contact"
        class="group relative text-xs font-semibold uppercase tracking-[2px] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors duration-200 py-1"
      >
        <span>Contactos</span>
        <span
          class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-[var(--cor-destaque)] transition-all duration-300 group-hover:w-full"
        ></span>
      </a>

      <a
        data-wa-agendar
        href="https://wa.me/351919786224"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-sm shadow-[rgba(212,49,136,0.25)] hover:shadow-md hover:shadow-[rgba(212,49,136,0.35)] hover:-translate-y-0.5"
      >
        <span>Agendar</span>
      </a>
    </nav>

    <label
      for="menu-toggle"
      class="lg:hidden flex flex-col justify-center items-center gap-1.5 w-10 h-10 rounded-full hover:bg-[var(--cor-fundo-suave)] cursor-pointer transition-colors peer-checked:[&>span:nth-child(1)]:rotate-45 peer-checked:[&>span:nth-child(1)]:translate-y-2 peer-checked:[&>span:nth-child(2)]:opacity-0 peer-checked:[&>span:nth-child(3)]:-rotate-45 peer-checked:[&>span:nth-child(3)]:-translate-y-2"
    >
      <span
        class="block h-0.5 w-5 bg-[var(--cor-texto)] transition-all duration-300 origin-center"
      ></span>
      <span
        class="block h-0.5 w-5 bg-[var(--cor-texto)] transition-all duration-300"
      ></span>
      <span
        class="block h-0.5 w-5 bg-[var(--cor-texto)] transition-all duration-300 origin-center"
      ></span>
    </label>

    <div
      class="hidden peer-checked:flex lg:hidden flex-col absolute top-full left-0 w-full bg-white/98 backdrop-blur-md border-b border-[var(--cor-secundaria)]/30 px-6 py-8 shadow-xl items-center text-center gap-5 transition-all"
    >
      <a
        href="/about"
        class="font-serif text-lg text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors"
      >
        A Klassy
      </a>

      <a
        href="/services"
        class="font-serif text-lg text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors"
      >
        Serviços
      </a>

      <a
        href="/gallery"
        class="font-serif text-lg text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors"
      >
        Portefólio
      </a>

      <a
        href="/contact"
        class="font-serif text-lg text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] transition-colors"
      >
        Contactos
      </a>

      <div class="w-16 h-px bg-[var(--cor-secundaria)]/30 my-1"></div>

      <a
        data-wa-agendar
        href="https://wa.me/351919786224"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full max-w-xs inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md shadow-[rgba(212,49,136,0.25)] hover:-translate-y-0.5"
      >
        Agendar Serviço
      </a>
    </div>
  </div>
</header>

<script>
  function configurarWhatsAppDinamico() {
    const hora = new Date().getHours();
    let saudacao = "Bom dia";

    if (hora >= 13 && hora < 20) {
      saudacao = "Boa tarde";
    } else if (hora >= 20 || hora < 6) {
      saudacao = "Boa noite";
    }

    const mensagem = `${saudacao}, gostaria de agendar uma marcação (escreva aqui)`;
    const urlWA = `https://wa.me/351919786224?text=${encodeURIComponent(mensagem)}`;

    const botoes =
      document.querySelectorAll<HTMLAnchorElement>("[data-wa-agendar]");
    botoes.forEach((btn) => {
      btn.href = urlWA;
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", configurarWhatsAppDinamico);
  } else {
    configurarWhatsAppDinamico();
  }

  document.addEventListener("astro:page-load", configurarWhatsAppDinamico);
</script>
