---

---

<div
  id="cookie-banner"
  class="fixed z-[9999] bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-3xl bg-white/95 backdrop-blur-md p-6 sm:p-7 rounded-3xl border border-[var(--cor-secundaria)]/35 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-5 md:gap-8 transition-all duration-700 ease-out translate-y-36 opacity-0 pointer-events-none"
  role="alert"
>
  <!-- TEXTO & PRIVACIDADE -->
  <div class="text-center md:text-left flex-1">
    <div class="inline-flex items-center gap-2 mb-1.5">
      <span class="text-sm">🍪</span>
      <h3
        class="font-serif text-lg sm:text-xl text-[var(--cor-texto)] font-medium"
      >
        A sua privacidade é importante
      </h3>
    </div>

    <p
      class="text-xs sm:text-sm text-[var(--cor-texto-suave)] font-light leading-relaxed"
    >
      Utilizamos cookies essenciais para o funcionamento do site e, com o seu
      consentimento, cookies analíticos para melhorar a sua experiência. Pode
      ler mais na nossa
      <a
        href="/privacy_cookies"
        class="text-[var(--cor-destaque)] font-medium underline decoration-[var(--cor-secundaria)]/60 underline-offset-2 hover:text-[var(--cor-destaque-hover)] transition-colors ml-0.5"
      >
        Política de Privacidade
      </a>.
    </p>
  </div>

  <!-- BOTÕES DE CONSENTIMENTO EM PÍLULA -->
  <div
    class="flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto shrink-0 min-w-[200px]"
  >
    <!-- Aceitar Todos -->
    <button
      id="btn-aceitar-cookies"
      type="button"
      class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full bg-[var(--cor-destaque)] hover:bg-[var(--cor-destaque-hover)] text-white text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md shadow-[rgba(212,49,136,0.25)] hover:shadow-lg hover:-translate-y-0.5 cursor-pointer text-center"
    >
      Aceitar Todos
    </button>

    <!-- Apenas Essenciais -->
    <button
      id="btn-recusar-cookies"
      type="button"
      class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full bg-white hover:bg-[var(--cor-fundo-suave)] border border-[var(--cor-secundaria)]/40 hover:border-[var(--cor-destaque)] text-[var(--cor-texto)] hover:text-[var(--cor-destaque)] text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-2xs hover:-translate-y-0.5 cursor-pointer text-center"
    >
      Apenas Essenciais
    </button>
  </div>
</div>

<script>
  let analyticsCarregado = false;

  const iniciarCookieBanner = () => {
    const banner = document.getElementById("cookie-banner");
    const btnAceitar = document.getElementById("btn-aceitar-cookies");
    const btnRecusar = document.getElementById("btn-recusar-cookies");

    // 1. CARREGAMENTO DO GOOGLE ANALYTICS
    const carregarScriptsAnaliticos = () => {
      if (analyticsCarregado) return;

      console.log("🟢 Consentimento dado: A carregar Google Analytics...");

      const scriptGA = document.createElement("script");
      scriptGA.async = true;
      scriptGA.src = "https://www.googletagmanager.com/gtag/js?id=G-CD48HF372K";
      document.head.appendChild(scriptGA);

      const win = window as any;
      if (typeof win.gtag === "function") {
        win.gtag("config", "G-CD48HF372K");
      }

      analyticsCarregado = true;
    };

    // 2. VERIFICAÇÃO DO CONSENTIMENTO GUARDADO
    const consentimento = localStorage.getItem("consentimento_cookies_klassy");

    if (consentimento === "todos") {
      carregarScriptsAnaliticos();
    } else if (!consentimento && banner) {
      setTimeout(() => {
        banner.classList.remove(
          "translate-y-36",
          "opacity-0",
          "pointer-events-none",
        );
        banner.classList.add(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );
      }, 700);
    }

    // 3. REGISTO DA ESCOLHA E ANIMAÇÃO DE SAÍDA
    const fecharBanner = (escolha: string) => {
      localStorage.setItem("consentimento_cookies_klassy", escolha);

      if (banner) {
        banner.classList.add(
          "translate-y-36",
          "opacity-0",
          "pointer-events-none",
        );
        banner.classList.remove(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );
      }

      if (escolha === "todos") {
        carregarScriptsAnaliticos();
      } else {
        console.log(
          "🔴 Consentimento recusado: Apenas cookies essenciais ativos.",
        );
      }
    };

    btnAceitar?.addEventListener("click", () => fecharBanner("todos"));
    btnRecusar?.addEventListener("click", () => fecharBanner("essenciais"));
  };

  // Suporte a carregamento inicial e View Transitions do Astro
  document.addEventListener("DOMContentLoaded", iniciarCookieBanner);
  document.addEventListener("astro:page-load", iniciarCookieBanner);
</script>
